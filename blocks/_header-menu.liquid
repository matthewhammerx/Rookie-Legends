{%- doc -%}
  Renders a header menu block.

  @param {string} [variant] - What version of the menu to render. Defaults to header menu.
  @param {string} [transparent] - Show a transparent menu
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
%}

{% case variant %}
  {% when 'mobile' %}
    <div
      class="header__drawer"
      ref="headerDrawerContainer"
      data-hydration-key="header-drawer-mobile"
      {{ block.shopify_attributes }}
    >
      {% render 'header-drawer', linklist: block_settings.menu, data_header_drawer_type: 'mobile-drawer' %}
    </div>

  {% when 'navigation_bar' %}
    {% if block_settings.navigation_bar == true %}
      <div
        class="menu-list menu-list--mobile{% if transparent == blank %} color-{{ block_settings.color_scheme_navigation_bar }}{% endif %}"
        style="--menu-horizontal-gap: 15px; --mobile-nav-margin: auto;"
        data-hydration-key="header-menu-mobile-navigation-bar"
      >
        <div class="menu-list__scroll-container">
          <ul
            class="menu-list__list list-unstyled"
            role="list"
          >
            {% for link in block_settings.menu.links %}
              <li>
                <a
                  href="{{ link.url }}"
                  id="MenuItem-{{ link.handle }}"
                  class="menu-list__item"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
  {% else %}
    {%- comment -%}
      Custom desktop menu (Rookie Legends): links with a gradient underline and
      a glass dropdown panel of collection cards. Hover (with intent delay),
      click and keyboard open it; mouse-out, outside click and Escape close it.
      Items that don't fit move into a "More" dropdown. The root keeps
      ref="headerMenu" and the header-menu class the header section relies on.
    {%- endcomment -%}
    <div
      class="header-menu rl-nav"
      ref="headerMenu"
      data-rl-nav
      data-hydration-key="header-menu"
      {{ block.shopify_attributes }}
    >
      <nav
        class="rl-nav__nav"
        aria-label="{{ 'accessibility.header_navigation_label' | t }}"
        style="{% render 'menu-font-styles', settings: block_settings %}"
      >
        <ul class="rl-nav__list" role="list" data-rl-list>
          {%- for link in block_settings.menu.links -%}
            <li class="rl-nav__item{% if link.active %} is-current{% endif %}" data-rl-item>
              {%- if link.links != blank -%}
                <a
                  href="{{ link.url }}"
                  class="rl-nav__link"
                  data-rl-trigger
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls="RlPanel-{{ block.id }}-{{ forloop.index }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="rl-nav__label">{{ link.title | escape }}</span>
                  <svg class="rl-nav__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </a>
                <div class="rl-nav__panel" id="RlPanel-{{ block.id }}-{{ forloop.index }}" data-rl-panel>
                  <div class="rl-nav__panel-inner">
                    <div class="rl-nav__intro">
                      <span class="rl-nav__eyebrow">Shop</span>
                      <p class="rl-nav__intro-title">{{ link.title | escape }}</p>
                      <a class="rl-nav__all" href="{{ link.url }}">
                        View all
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      </a>
                    </div>
                    <ul class="rl-nav__cards" role="list">
                      {%- for child in link.links -%}
                        {%- liquid
                          assign child_image = null
                          if child.type == 'collection_link' or child.type == 'product_link'
                            assign child_image = child.object.featured_image
                          endif
                        -%}
                        <li class="rl-nav__card-item" style="--i: {{ forloop.index0 }};">
                          <a class="rl-nav__card" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                            <span class="rl-nav__card-media">
                              {%- if child_image -%}
                                {{
                                  child_image
                                  | image_url: width: 640
                                  | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '260px', alt: ''
                                }}
                              {%- else -%}
                                <span class="rl-nav__card-letter" aria-hidden="true">{{ child.title | slice: 0 }}</span>
                              {%- endif -%}
                            </span>
                            <span class="rl-nav__card-title">{{ child.title | escape }}</span>
                          </a>
                          {%- if child.links != blank -%}
                            <ul class="rl-nav__chips" role="list">
                              {%- for grandchild in child.links -%}
                                <li><a class="rl-nav__chip" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              {%- else -%}
                <a
                  href="{{ link.url }}"
                  class="rl-nav__link"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="rl-nav__label">{{ link.title | escape }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
          <li class="rl-nav__item rl-nav__item--more" data-rl-more hidden>
            <button
              type="button"
              class="rl-nav__link"
              data-rl-trigger
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="RlPanel-{{ block.id }}-more"
            >
              <span class="rl-nav__label">{{ 'actions.more' | t }}</span>
              <svg class="rl-nav__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="rl-nav__panel rl-nav__panel--list" id="RlPanel-{{ block.id }}-more" data-rl-panel>
              <ul class="rl-nav__more-list" role="list" data-rl-more-list></ul>
            </div>
          </li>
        </ul>
      </nav>
    </div>

    <script>
      (function () {
        if (window.__rlNavBound) return;
        window.__rlNavBound = true;

        var OPEN_DELAY = 90;
        var CLOSE_DELAY = 200;
        var openItem = null;
        var timers = new WeakMap();

        function headerBottom(item) {
          var header = item.closest('header-component, header, .header') || item.closest('[data-rl-nav]');
          return Math.max(0, header.getBoundingClientRect().bottom);
        }

        // Place the fixed panel right under the header. If an ancestor is
        // transformed (sticky header animations), "fixed" becomes relative to
        // it, so measure where it landed and correct.
        function placePanel(item) {
          var panel = item.querySelector(':scope > [data-rl-panel]');
          if (!panel || item.hasAttribute('data-rl-more')) return;
          var want = headerBottom(item);
          item.style.setProperty('--rl-panel-top', want + 'px');
          var got = panel.getBoundingClientRect().top;
          if (Math.abs(got - want) > 1) item.style.setProperty('--rl-panel-top', want - (got - want) + 'px');
        }

        function open(item) {
          if (openItem && openItem !== item) close(openItem, true);
          var panel = item.querySelector(':scope > [data-rl-panel]');
          var trigger = item.querySelector(':scope > [data-rl-trigger]');
          if (!panel || !trigger) return;
          item.classList.add('is-open');
          placePanel(item);
          trigger.setAttribute('aria-expanded', 'true');
          openItem = item;
        }

        function close(item, instant) {
          if (!item) return;
          var trigger = item.querySelector(':scope > [data-rl-trigger]');
          item.classList.remove('is-open');
          if (instant) item.classList.add('no-anim');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
          if (openItem === item) openItem = null;
          if (instant) requestAnimationFrame(function () { item.classList.remove('no-anim'); });
        }

        function schedule(item, fn, delay) {
          clearTimeout(timers.get(item));
          timers.set(item, setTimeout(fn, delay));
        }

        document.addEventListener('pointerover', function (e) {
          if (e.pointerType !== 'mouse') return;
          var item = e.target.closest && e.target.closest('[data-rl-nav] [data-rl-item], [data-rl-nav] [data-rl-more]');
          if (!item || !item.querySelector(':scope > [data-rl-panel]')) return;
          clearTimeout(timers.get(item));
          if (item.classList.contains('is-open')) return;
          schedule(item, function () { open(item); }, openItem ? 0 : OPEN_DELAY);
        });

        document.addEventListener('pointerout', function (e) {
          if (e.pointerType !== 'mouse') return;
          var item = e.target.closest && e.target.closest('[data-rl-nav] [data-rl-item], [data-rl-nav] [data-rl-more]');
          if (!item || (e.relatedTarget && item.contains(e.relatedTarget))) return;
          schedule(item, function () { close(item); }, CLOSE_DELAY);
        });

        document.addEventListener('click', function (e) {
          var trigger = e.target.closest && e.target.closest('[data-rl-nav] [data-rl-trigger]');
          if (trigger) {
            var item = trigger.parentElement;
            // Parent links open their panel; use "View all" inside to go to the page
            e.preventDefault();
            if (item.classList.contains('is-open')) close(item);
            else open(item);
            return;
          }
          if (openItem && !openItem.contains(e.target)) close(openItem);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape' || !openItem) return;
          var trigger = openItem.querySelector(':scope > [data-rl-trigger]');
          close(openItem);
          if (trigger) trigger.focus();
        });

        document.addEventListener('focusout', function (e) {
          if (!openItem) return;
          var next = e.relatedTarget;
          if (next && !openItem.contains(next)) close(openItem);
        });

        window.addEventListener('scroll', function () {
          if (openItem) placePanel(openItem);
        }, { passive: true });

        /* "More": move items that don't fit into an overflow dropdown */
        function fit(nav) {
          var list = nav.querySelector('[data-rl-list]');
          var more = nav.querySelector('[data-rl-more]');
          var moreList = nav.querySelector('[data-rl-more-list]');
          if (!list || !more || !moreList) return;
          var items = Array.prototype.slice.call(list.querySelectorAll(':scope > [data-rl-item]'));
          items.forEach(function (it) { it.hidden = false; });
          more.hidden = true;
          moreList.innerHTML = '';
          var available = nav.clientWidth;
          if (!available || list.scrollWidth <= available + 1) return;
          more.hidden = false;
          for (var i = items.length - 1; i >= 0 && list.scrollWidth > available + 1; i--) {
            items[i].hidden = true;
          }
          items.forEach(function (it) {
            if (!it.hidden) return;
            var link = it.querySelector(':scope > .rl-nav__link');
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.className = 'rl-nav__more-link';
            a.href = link.getAttribute('href');
            a.textContent = link.textContent.trim();
            li.appendChild(a);
            moreList.appendChild(li);
          });
        }

        function fitAll() {
          document.querySelectorAll('[data-rl-nav]').forEach(fit);
        }

        var resizeTimer;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(fitAll, 120);
        });
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitAll);
        window.addEventListener('load', fitAll);
        fitAll();
      })();
    </script>
{% endcase %}

{% style %}
  .header__underlay {
    --color-submenu: rgb({{ block_settings.color_scheme.settings.background.rgba }});
  }
{% endstyle %}
{% stylesheet %}
  .header__drawer {
    --header-drawer-min-height: 60px;
    display: flex;
    min-height: var(--header-drawer-min-height);
    align-items: center;
  }

  #header-component[data-menu-style='drawer'] .header__drawer {
    display: flex;
    min-height: var(--header-drawer-min-height);
  }

  @media screen and (min-width: 750px) {
    #header-component[data-menu-style='menu'] .header__drawer {
      display: none;
      min-height: 0;
    }
  }

  .header--compact .header__drawer {
    min-height: var(--minimum-touch-target);
  }

  .menu-list--mobile {
    &.menu-list {
      display: grid;
    }

    & .menu-list__list {
      width: max-content;
      margin-inline: auto;
      gap: var(--menu-horizontal-gap);
    }

    & li {
      width: max-content;
      padding-block: var(--padding-sm);
    }

    & li:first-of-type {
      padding-inline-start: var(--menu-horizontal-gap);
    }

    & li:last-of-type {
      padding-inline-end: var(--menu-horizontal-gap);
    }

    & a {
      color: var(--color-foreground);
    }
  }

  .menu-list__scroll-container {
    position: relative;
    overflow-x: auto;
    mask-image: linear-gradient(to right, transparent, #000 20px, #000 calc(100% - 20px), transparent);
    padding-block: var(--padding-2xs);
  }

  .menu-list {
    --menu-horizontal-gap: var(--gap-xl);
    --menu-vertical-gap: var(--gap-xl);

    display: flex;
    height: 100%;
  }

  .menu-list__list {
    display: flex;
    justify-content: var(--grid-area-alignment);
  }

  .menu-list__list-item {
    flex-shrink: 0;
    white-space: nowrap;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .menu-list__list-item[aria-hidden='true'] {
    visibility: hidden;
  }

  .menu-list__link {
    font-family: var(--menu-top-level-font-family);
    font-style: var(--menu-top-level-font-style);
    font-weight: var(--menu-top-level-font-weight);
    font-size: var(--menu-top-level-font-size);
    line-height: var(--menu-top-level-font-line-height);
    text-transform: var(--menu-top-level-font-case);
    color: var(--menu-top-level-font-color);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    cursor: pointer;
    height: 100%;
    margin-block: 0;

    @media screen and (min-width: 750px) {
      font-size: var(--menu-top-level-font-size-desktop);
    }
  }

  .menu-list__link-title {
    padding-inline: calc(var(--gap-xl) / 2);
  }
  [slot='overflow'] .menu-list__link-title {
    padding-inline: 0;
  }

  .menu-list__list-item:not([slot='overflow']) {
    flex-direction: column;
  }
  .menu-list__list-item:not([slot='overflow'])::after {
    content: '';
    width: 100%;
    height: var(--header-padding);
    margin-bottom: calc(-1 * var(--header-padding));
  }

  [slot='overflow'] > .menu-list__link::after {
    content: none;
  }

  /*
    Non-hovered links stay at full color (no dimming) — only the
    hovered/active link changes color, via the rules below.
  */

  /* stylelint-disable-next-line selector-max-specificity */
  .menu-list:not(:has(.menu-list__list-item:hover)) .menu-list__link--active,
  .menu-list .menu-list__list-item[slot='overflow'] .menu-list__link[aria-expanded='true'] {
    color: #fff !important;
  }

  .menu-list .menu-list__list-item:where(:hover, :focus-within) .menu-list__link {
    color: #ff2fb1 !important;
  }

  /*
    The menu's color scheme resolves to near-black text, which is
    unreadable against the transparent/dark header. Force plain
    white for the nav labels themselves (not the sell-my-collection
    pill or other header chrome).
  */
  .menu-list__link {
    color: #fff !important;
  }

  .overflow-menu::part(list) {
    /* Make sure focus outline is not cut off by overflow hidden */
    --focus-outline-size: calc(var(--focus-outline-offset) + var(--focus-outline-width));

    gap: 0;
    margin-inline: calc(-1 * var(--menu-horizontal-gap) / 2);
  }

  .overflow-menu {
    background-color: transparent;
    padding: var(--focus-outline-size);
    margin: calc(-1 * var(--focus-outline-size));
  }

  /** mega menu **/
  .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-padding-block-start: var(--padding-3xl);
    --submenu-padding-block-end: var(--padding-3xl);

    background-color: transparent;
  }

  .header__row[style*='--border-bottom-width: 0px'] {
    .menu-list__submenu.color-scheme-matches-parent,
    .overflow-menu.color-scheme-matches-parent::part(overflow) {
      --submenu-padding-block-start: 0px;
    }
  }

  .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-content-opacity: 0;
    --submenu-content-animation: opacity calc(var(--submenu-animation-speed) * 0.75) var(--animation-easing);

    visibility: hidden;
    position: absolute;
    width: 100%;
    left: 0;
    top: calc(100% - 1px + var(--border-bottom-width) - (var(--full-open-header-height) - var(--submenu-height)));
    z-index: var(--layer-header-menu);
    padding-inline: var(--padding-inline);
    /* Clip path starts at header height so it doesn't mess with the pointer events in the header */
    clip-path: rect(var(--header-height) 100% var(--full-open-header-height) 0); /* stylelint-disable-line */
    transition: clip-path var(--submenu-animation-speed) var(--ease-out-cubic); /* stylelint-disable-line */
  }

  [data-submenu-overlap-bottom-row] {
    .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu,
    .overflow-menu::part(overflow) {
      clip-path: rect(var(--top-row-height) 100% var(--full-open-header-height) 0); /* stylelint-disable-line */
    }
  }

  /* Show the submenus on hover */
  .menu-list__list-item:has([aria-expanded='true']) > .menu-list__submenu,
  /* Show the overflow menu when a menu item is hovered */
  .overflow-menu:has([slot="overflow"] [aria-expanded='true'])::part(overflow-list),
  /* Keep the submenus open when they are hovered */
  .menu-list__submenu:is(:hover),
  .overflow-menu::part(overflow):hover {
    --submenu-content-opacity: 1;

    visibility: visible;
  }

  .overflow-menu::part(overflow) {
    --menu-top-level-font-size: var(--font-size--xlarge);

    display: grid;
    grid-template-columns: var(--full-page-grid-with-margins);
  }

  .overflow-menu::part(overflow-list) {
    position: relative;
    display: grid;
    grid-template-columns: minmax(auto, 200px) 1fr;
    grid-template-areas: 'left right';
    grid-template-rows: max-content;
    grid-gap: 0;
    grid-column: 2;
  }

  .menu-list__list-item:is([slot='overflow']) {
    --menu-top-level-font-color: var(--color-foreground);
    --menu-top-level-font-color-rgb: var(--color-foreground-rgb);

    display: contents;
    white-space: normal;

    .menu-list__link {
      grid-area: left;
      grid-row: auto;
      height: min-content;
      font-size: var(--font-size--xl);
      transition: var(--submenu-content-animation);
    }

    .menu-list__submenu {
      visibility: hidden;
      grid-row: 1;
      grid-area: right;
      grid-row-end: span calc(var(--overflow-count) + 1);
      padding-inline-start: var(--menu-horizontal-gap);
    }

    .menu-list__submenu-inner {
      transform: none;
      grid-column: unset;
      padding-block: 0;
    }

    .menu-list__link[aria-expanded='true'] + .menu-list__submenu {
      visibility: visible;
    }
  }

  .header-menu {
    height: 100%;
  }

  .menu-list__submenu-inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .menu-list__submenu-inner,
  .overflow-menu::part(overflow-list) {
    padding-block-start: var(--submenu-padding-block-start);
    padding-block-end: var(--submenu-padding-block-end);
    padding-inline: var(--section-padding-inline);
    opacity: var(--submenu-content-opacity);
    transition: var(--submenu-content-animation);
    transform: translateY(calc(var(--full-open-header-height) - var(--submenu-height)));

    /* Make overflow menu scrollable when content exceeds viewport */
    max-height: calc(80vh - var(--header-height));
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / var(--opacity-40)) transparent;
  }

  /* ================================
   * Mega-menu panel styling (transparent, blurred backdrop)
   * ================================ */
  /*
    header-component sets --color-scheme-top-row / --color-scheme-bottom-row
    via inline style, per page/scroll state (it's sometimes solid white).
    Force all three source variables transparent at the root so nothing
    fed by them can ever render a solid band, on any page.
  */
  #header-component,
  header-component {
    --color-scheme-top-row: transparent !important;
    --color-scheme-bottom-row: transparent !important;
  }

  /*
    The theme's native ".header[transparent]:has(...)" rules flip
    --color-foreground/-background/-border to "inherit" whenever any
    nav link is hovered or a dropdown is open — meant to swap the
    header to a solid readable scheme on interaction. Since we want
    the header to never change except the nav text color, pin these
    to the header's own idle values at all times.
  */
  #header-component {
    --color-foreground: rgb(255 255 255 / 1) !important;
    --color-foreground-rgb: 255 255 255 !important;
    --color-background: rgb(0 0 0 / 0) !important;
    --color-background-rgb: 0 0 0 !important;
    --color-border: rgb(255 255 255 / 1) !important;
    --color-border-rgb: 255 255 255 !important;
  }

  .header__underlay {
    --color-submenu: transparent !important;
  }

  /*
    Always transparent — idle, hovered, or a dropdown open. No state
    ever changes the header's own background. The only thing hover
    changes is text color (see the nav-color rules elsewhere in this
    file).
  */
  .header__underlay-open,
  .header__underlay-closed {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .menu-list__submenu-inner {
    background: transparent;
    border-radius: 0;
    border: none;
    box-shadow: none;
  }

  /*
    Compact floating dropdown box (Zardo-style): instead of a full-width
    bar, the panel becomes a small rounded card anchored under the
    trigger link, with its tiles wrapping into a centered grid.
  */
  @media screen and (min-width: 750px) {
    .menu-list__list-item:not([slot='overflow']) {
      position: relative;
    }

    .menu-list__list-item:not([slot='overflow']) > .menu-list__submenu {
      width: max-content !important;
      max-width: 900px;
      left: 0 !important;
      right: auto;
    }

    .menu-list__list-item:not([slot='overflow']) > .menu-list__submenu .menu-list__submenu-inner {
      padding: 16px;
      background: rgba(8, 8, 11, 0.78);
      backdrop-filter: blur(36px) saturate(150%);
      -webkit-backdrop-filter: blur(36px) saturate(150%);
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      overflow: hidden;
      isolation: isolate;
    }

    .menu-list__list-item:not([slot='overflow']) .mega-menu__grid {
      display: block !important;
      width: auto;
      padding-inline: 0 !important;
    }

    .menu-list__list-item:not([slot='overflow']) .mega-menu__list {
      display: flex !important;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      width: auto;
    }

    .menu-list__list-item:not([slot='overflow']) .mega-menu__column {
      grid-column: unset !important;
      flex: 0 0 190px;
    }

    /*
      When a dropdown has exactly 5 tiles, cap the row width to fit only
      3 across so the last 2 wrap to a centered second row (3 on top,
      2 on bottom) instead of 4 on top and 1 stranded alone.
    */
    .menu-list__list-item:not([slot='overflow']) .mega-menu__list:has(> .mega-menu__column:nth-child(5):last-child) {
      max-width: 606px;
    }
  }

  .mega-menu__column {
    border-radius: 14px;
    padding: 10px 14px;
    transition: background-color 0.2s ease;
  }

  .mega-menu__column:hover {
    background-color: rgba(255, 47, 177, 0.06);
  }

  .mega-menu__link--parent {
    color: #ff2fb1 !important;
  }

  .mega-menu__link:hover {
    color: #ff2fb1 !important;
  }

  /* Same scheme issue as the top nav: base tile-label color resolves
     to near-black. Force white, pink stays on hover (rules above). */
  .mega-menu__link {
    color: #fff !important;
  }

  /* The category name is already baked into the tile image (large,
     stylized) — the text label underneath only needs to be a small
     caption, not a second big heading. */
  .mega-menu__link:has(.mega-menu__link-image) {
    font-size: 13px !important;
  }

  /* Animated chevron next to nav items that open a dropdown, flips
     to point up while the panel is open. */
  .menu-list__link[aria-haspopup='true'] {
    flex-direction: row;
    align-items: center;
    gap: 7px;
  }

  .menu-list__link[aria-haspopup='true']::after {
    content: '';
    width: 5px;
    height: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.25s ease;
    margin-top: -2px;
  }

  .menu-list__link[aria-haspopup='true'][aria-expanded='true']::after {
    transform: rotate(225deg);
    margin-top: 2px;
  }

  /* The title span's own right padding (native item-to-item spacing)
     was pushing the arrow away from the text — move that spacing to
     after the arrow instead so it sits right next to the label. */
  .menu-list__link[aria-haspopup='true'] .menu-list__link-title {
    padding-right: 0;
  }

  .menu-list__link[aria-haspopup='true']::after {
    margin-right: calc(var(--gap-xl) / 2);
  }
  /* ============ End frosted-glass mega-menu card ============ */

  .mega-menu__link {
    font-family: var(--menu-child-font-family);
    font-style: var(--menu-child-font-style);
    font-weight: var(--menu-child-font-weight);
    font-size: var(--menu-child-font-size);
    line-height: var(--menu-child-font-line-height);
    text-transform: var(--menu-child-font-case);
    color: var(--menu-child-font-color);
    white-space: normal;
    text-decoration: none;
    display: inline-flex;
    padding: var(--padding-2xs) 0;

    &:hover {
      color: var(--menu-child-active-font-color);
    }
  }

  .mega-menu__link--parent {
    font-family: var(--menu-parent-font-family);
    font-style: var(--menu-parent-font-style);
    font-weight: var(--menu-parent-font-weight);
    font-size: var(--menu-parent-font-size);
    line-height: var(--menu-parent-font-line-height);
    text-transform: var(--menu-parent-font-case);
    color: var(--menu-parent-font-color);

    &:hover {
      color: var(--menu-parent-active-font-color);
    }
  }

  @media screen and (max-width: 989px) {
    .mega-menu__content-list-item--hidden-tablet {
      display: none;
    }
  }

  .mega-menu__link:has(.mega-menu__link-image) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__link-image {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    object-fit: cover;
    border-radius: var(--menu-image-border-radius);
  }

  /* Fix alignment for collection image mode links without images */

  /* Target only top-level links (direct children of column > div) in collection image mode */
  .mega-menu__grid:has(.mega-menu__link-image)
    .mega-menu__column
    > div
    > .mega-menu__link:not(:has(.mega-menu__link-image)) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__grid:has(.mega-menu__link-image)
    .mega-menu__column
    > div
    > .mega-menu__link:not(:has(.mega-menu__link-image))::before {
    content: '';
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    background-color: var(--color-foreground-muted);
    opacity: 0.1;
    border-radius: var(--menu-image-border-radius);
  }

  .mega-menu__grid {
    display: grid;
    grid-template-columns: repeat(var(--menu-columns-tablet), minmax(0, 1fr));
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
    width: 100%;

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__column {
    grid-column: span 1;
  }

  .mega-menu__column--span-2 {
    grid-column: span 2;
  }

  .mega-menu__column--span-3 {
    grid-column: span 3;
  }

  .mega-menu__column--span-4 {
    grid-column: span 4;
  }

  .mega-menu__column--wide-collection-image {
    grid-column: span 1;

    @media screen and (min-width: 990px) {
      grid-column: span 2;
    }
  }

  .mega-menu__submenu .mega-menu__column--wide-collection-image {
    grid-column: span 1;
  }

  .mega-menu__content-list {
    display: grid;
    justify-content: end;
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
  }

  .mega-menu__content-list--products {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 1fr));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__content-list--collections {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 300px));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 300px));
    }
  }

  .mega-menu__list {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: span var(--menu-columns-tablet);
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-columns-desktop);
    }
  }

  .mega-menu__content {
    grid-column: span var(--menu-content-columns-tablet) / -1;

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-content-columns-desktop) / -1;
    }
  }

  .menu-list__list-item[slot='overflow'] .section {
    grid-template-columns: 1fr;
  }

  .menu-list__list-item[slot='overflow'] .section .mega-menu__grid {
    grid-column: 1;
  }

  .mega-menu__content-list li {
    white-space: normal;
  }

  /* mega more menu */
  .mega-menu__more-list {
    --menu-child-font-size: var(--font-size--xl);

    width: 200px;
  }

  .mega-menu__submenu {
    /* preserves the inherited grid layout when this submenu wrapper is used */
    display: contents;
  }

  /* =====================================================================
     Rookie Legends custom desktop menu (.rl-nav)
     ===================================================================== */
  .rl-nav {
    --rl-pink: #ff2fb1;
    --rl-violet: #8b5cff;
    --rl-frost: #7fdbff;

    display: flex;
    flex: 1 1 auto;
    align-items: center;
    min-width: 0;
  }

  .rl-nav__nav {
    width: 100%;
    min-width: 0;
  }

  .rl-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.1vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  .rl-nav__item[hidden] {
    display: none;
  }

  .rl-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 0;
    border: 0;
    background: none;
    color: var(--menu-top-level-font-color, currentColor);
    font-family: var(--menu-top-level-font-family);
    font-size: var(--menu-top-level-font-size-desktop, 1rem);
    font-style: var(--menu-top-level-font-style);
    font-weight: var(--menu-top-level-font-weight);
    text-transform: var(--menu-top-level-font-case);
    letter-spacing: 0.03em;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease, text-shadow 0.25s ease;
  }

  /* Gradient underline grows from the center */
  .rl-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--rl-pink), var(--rl-violet), var(--rl-frost));
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s cubic-bezier(0.22, 0.8, 0.26, 1);
  }

  .rl-nav__link:hover,
  .rl-nav__item.is-open > .rl-nav__link {
    text-shadow: 0 0 18px rgb(255 47 177 / 0.45);
  }

  .rl-nav__link:hover::after,
  .rl-nav__item.is-open > .rl-nav__link::after,
  .rl-nav__link[aria-current='page']::after,
  .rl-nav__item.is-current > .rl-nav__link::after {
    transform: scaleX(1);
  }

  .rl-nav__link:focus-visible {
    outline: 2px solid var(--rl-frost);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .rl-nav__chev {
    width: 14px;
    height: 14px;
    opacity: 0.8;
    transition: transform 0.3s ease;
  }

  .rl-nav__item.is-open .rl-nav__chev {
    transform: rotate(180deg);
  }

  /* ---- Dropdown panel ---- */
  .rl-nav__panel {
    position: fixed;
    top: var(--rl-panel-top, 80px);
    left: 50%;
    z-index: 60;
    width: min(1120px, calc(100vw - 48px));
    padding-top: 12px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.22s ease,
      transform 0.3s cubic-bezier(0.22, 0.8, 0.26, 1),
      visibility 0s linear 0.3s;
    white-space: normal;
  }

  .rl-nav__item.is-open > .rl-nav__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }

  .rl-nav__item.no-anim > .rl-nav__panel {
    transition: none;
  }

  .rl-nav__panel-inner {
    position: relative;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 30px;
    padding: 28px;
    overflow: hidden;
    color: #fff;
    background: rgb(12 8 16 / 0.9);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 22px;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }

  .rl-nav__panel-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--rl-pink), var(--rl-violet), var(--rl-frost));
  }

  .rl-nav__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding-right: 26px;
    border-right: 1px solid rgb(255 255 255 / 0.08);
  }

  .rl-nav__eyebrow {
    color: var(--rl-pink);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .rl-nav__intro-title {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 2.1rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .rl-nav__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 9px 16px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .rl-nav__all svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .rl-nav__all:hover {
    border-color: var(--rl-pink);
    background: rgb(255 47 177 / 0.12);
  }

  .rl-nav__all:hover svg {
    transform: translateX(3px);
  }

  .rl-nav__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rl-nav__item.is-open .rl-nav__card-item {
    animation: rl-nav-card-in 0.36s cubic-bezier(0.22, 0.8, 0.26, 1) both;
    animation-delay: calc(var(--i, 0) * 35ms + 60ms);
  }

  @keyframes rl-nav-card-in {
    from { opacity: 0; transform: translateY(8px); }
  }

  .rl-nav__card {
    display: block;
    color: #fff;
    text-decoration: none;
  }

  .rl-nav__card-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.08);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .rl-nav__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.22, 0.8, 0.26, 1);
  }

  .rl-nav__card-letter {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-heading--family, inherit);
    font-size: 3rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--rl-pink), var(--rl-violet) 55%, var(--rl-frost));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .rl-nav__card:hover .rl-nav__card-media,
  .rl-nav__card:focus-visible .rl-nav__card-media {
    border-color: rgb(255 47 177 / 0.7);
    box-shadow: 0 0 24px -6px rgb(255 47 177 / 0.6);
  }

  .rl-nav__card:hover img {
    transform: scale(1.06);
  }

  .rl-nav__card:focus-visible {
    outline: none;
  }

  .rl-nav__card-title {
    display: block;
    margin-top: 10px;
    font-family: var(--menu-top-level-font-family, inherit);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .rl-nav__card:hover .rl-nav__card-title {
    color: var(--rl-pink);
  }

  .rl-nav__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .rl-nav__chip {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    color: rgb(255 255 255 / 0.8);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .rl-nav__chip:hover {
    border-color: var(--rl-pink);
    color: #fff;
  }

  /* ---- "More" overflow list ---- */
  .rl-nav__item--more {
    position: relative;
  }

  .rl-nav__panel--list {
    position: absolute;
    top: 100%;
    left: auto;
    right: -12px;
    width: 240px;
    transform: translateY(8px);
  }

  .rl-nav__item.is-open > .rl-nav__panel--list {
    transform: translateY(0);
  }

  .rl-nav__more-list {
    margin: 0;
    padding: 10px;
    list-style: none;
    background: rgb(12 8 16 / 0.92);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.55);
  }

  .rl-nav__more-link {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
    color: #fff;
    font-family: var(--menu-top-level-font-family, inherit);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .rl-nav__more-link:hover {
    background: rgb(255 47 177 / 0.12);
    color: var(--rl-pink);
  }

  @media (prefers-reduced-motion: reduce) {
    .rl-nav__panel,
    .rl-nav__link::after,
    .rl-nav__item.is-open .rl-nav__card-item {
      transition: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "default": "main-menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "primary"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_font_primary_size",
      "label": "t:settings.top_level_size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "1rem"
    },
    {
      "type": "select",
      "id": "menu_font_style",
      "label": "t:settings.submenu_size",
      "options": [
        {
          "value": "regular",
          "label": "t:options.small"
        },
        {
          "value": "inverse",
          "label": "t:options.medium"
        },
        {
          "value": "inverse_large",
          "label": "t:options.large"
        }
      ],
      "default": "inverse"
    },
    {
      "type": "select",
      "id": "type_font_primary_link",
      "label": "t:settings.font",
      "options": [
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "accent",
          "label": "t:options.accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "type_case_primary_link",
      "label": "t:settings.text_case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:content.submenu_feature"
    },
    {
      "type": "select",
      "id": "menu_style",
      "label": "t:settings.media_type",
      "info": "t:info.media_type_info",
      "options": [
        {
          "value": "text",
          "label": "t:options.none"
        },
        {
          "value": "collection_images",
          "label": "t:options.collection_images"
        },
        {
          "value": "featured_products",
          "label": "t:options.featured_products"
        },
        {
          "value": "featured_collections",
          "label": "t:options.featured_collections"
        }
      ],
      "default": "collection_images"
    },
    {
      "type": "select",
      "id": "featured_products_aspect_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "4 / 5",
          "label": "t:options.portrait"
        },
        {
          "value": "1 / 1",
          "label": "t:options.square"
        }
      ],
      "default": "4 / 5",
      "visible_if": "{{ block.settings.menu_style == 'featured_products' }}"
    },
    {
      "type": "select",
      "id": "featured_collections_aspect_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "16 / 9",
          "label": "t:options.landscape"
        },
        {
          "value": "1 / 1",
          "label": "t:options.square"
        }
      ],
      "default": "16 / 9",
      "visible_if": "{{ block.settings.menu_style == 'featured_collections' }}"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "t:settings.image_border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.menu_style != 'text' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "checkbox",
      "id": "navigation_bar",
      "label": "t:settings.navigation_bar"
    },
