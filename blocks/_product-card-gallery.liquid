

{% assign product = closest.product %}

{% capture children %}
  {% unless product == blank %}
    <div
      class="product-badges product-badges--{{ settings.badge_position }}"
      style="
        --badge-border-radius: {{ settings.badge_corner_radius }}px;
        --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
      "
    >
      {%- capture rl_ad_pct -%}{%- render 'rl-auto-discount', product: product -%}{%- endcapture -%}
      {%- assign rl_ad_pct = rl_ad_pct | strip | plus: 0 -%}
      {%- if product.available == false or product.compare_at_price > product.price or rl_ad_pct > 0 -%}
        {%- liquid
          if product.available == false
            assign badge_type = 'sold-out'
            assign badge_scheme = settings.badge_sold_out_color_scheme
            assign badge_style = settings.badge_sold_out_style | default: 'classic'
            assign badge_bg = settings.badge_sold_out_bg
            assign badge_text = settings.badge_sold_out_text
            assign badge_label = 'content.product_badge_sold_out' | t
          else
            assign badge_type = 'sale'
            assign badge_scheme = settings.badge_sale_color_scheme
            assign badge_style = settings.badge_sale_style | default: 'classic'
            assign badge_bg = settings.badge_sale_bg
            assign badge_text = settings.badge_sale_text
            assign badge_label = 'content.product_badge_sale' | t
            if rl_ad_pct > 0 and product.compare_at_price <= product.price
              assign badge_label = 'content.product_badge_sale_percent' | t: percent: rl_ad_pct
            elsif settings.badge_sale_show_percent and product.compare_at_price > 0
              assign savings = product.compare_at_price | minus: product.price
              assign percent = savings | times: 100 | divided_by: product.compare_at_price
              if percent > 0
                assign badge_label = 'content.product_badge_sale_percent' | t: percent: percent
              endif
            endif
          endif
        -%}
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            product-badges__badge--{{ badge_type }} product-badges__badge--style-{{ badge_style }}
            color-{{ badge_scheme }}
          "
          {% if badge_bg != blank %}
            style="--color-background: {{ badge_bg }};{% if badge_text != blank %} --color-foreground: {{ badge_text }};{% endif %}"
          {%- endif %}
        >
          <span class="product-badges__label">{{ badge_label }}</span>
        </div>
      {%- endif -%}
    </div>
    {%  if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title and price for the zoomed out grid view %}
{%- liquid
  # Expanded (zoom-out) view price color (Theme settings > Expanded grid view)
  assign rl_zp = settings.zoom_price_color | default: 'pink'
  case rl_zp
    when 'pink'
      assign rl_zp_color = '#ff2fb1'
    when 'frost'
      assign rl_zp_color = '#7fdbff'
    when 'gold'
      assign rl_zp_color = '#ffd400'
    when 'white'
      assign rl_zp_color = '#ffffff'
    when 'custom'
      assign rl_zp_color = settings.zoom_price_custom | default: '#ff2fb1'
    else
      assign rl_zp_color = '#ff2fb1'
  endcase
-%}
<div
  class="product-grid-view-zoom-out--details{% if rl_zp == 'holo' %} rl-zoom-price--holo{% endif %}"
  style="--rl-zoom-price: {{ rl_zp_color }};"
>
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
    <span class="h6">{{ 1999 | money }}</span>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
    <div class="h6">
      {% render 'price', product_resource: product, show_sale_price_first: true %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  /* Expanded (zoom-out) view: colored prices */
  .product-grid-view-zoom-out--details .h6 .price,
  .product-grid-view-zoom-out--details > span.h6 {
    color: var(--rl-zoom-price, #ff2fb1);
    font-size: calc(var(--font-size--xs) * 1.42);
    font-weight: 800;
    line-height: 1.2;
  }

  .product-grid-view-zoom-out--details.rl-zoom-price--holo .h6 .price,
  .product-grid-view-zoom-out--details.rl-zoom-price--holo > span.h6 {
    background: linear-gradient(90deg, #ff2fb1, #8b5cff, #3de8ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .product-grid-view-zoom-out--details .h6 .compare-at-price {
    margin-inline-start: 6px;
    color: rgb(255 255 255 / 0.45);
    font-weight: 500;
    text-decoration: line-through;
  }

  .product-badges {
    --badge-inset: max(var(--padding-xs), calc((var(--border-radius) + var(--padding-xs)) * (1 - cos(45deg))));

    position: absolute;
    z-index: var(--layer-flat);
  }

  .product-badges--bottom-left {
    bottom: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-left {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-right {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    right: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges__badge {
    --badge-font-size: var(--font-size--xs);

    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-foreground);
    background: var(--color-background);
    font-size: var(--badge-font-size);
    font-family: var(--badge-font-family);
    font-weight: var(--badge-font-weight);
    text-transform: var(--badge-text-transform);
    border-radius: var(--badge-border-radius);
  }

  .product-badges__badge--rectangle {
    padding-block: var(--badge-rectangle-padding-block);
    padding-inline: var(--badge-rectangle-padding-inline);
  }

  /* ---- Badge designs (Theme settings > Badges > Badge design) ---- */
  .product-badges__badge[class*='--style-']:not(.product-badges__badge--style-classic) {
    --badge-font-size: var(--font-size--xs);

    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Pill: fully rounded with a soft drop shadow */
  .product-badges__badge.product-badges__badge--style-pill {
    border-radius: 999px;
    padding: 0.45em 1em;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.35);
  }

  /* Slash tag: sharp, sporty, with an angled trailing edge */
  .product-badges__badge.product-badges__badge--style-tag {
    border-radius: 0;
    padding: 0.45em 1.35em 0.45em 0.8em;
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.7em) 100%, 0 100%);
    font-style: italic;
    box-shadow: inset 4px 0 0 rgb(0 0 0 / 0.25);
  }

  /* Stamp: tilted, double-bordered, like a grading slab stamp */
  .product-badges__badge.product-badges__badge--style-stamp {
    border-radius: 3px;
    padding: 0.5em 0.9em;
    letter-spacing: 0.18em;
    transform: rotate(-6deg);
    box-shadow:
      inset 0 0 0 2px var(--color-background),
      inset 0 0 0 3.5px var(--color-foreground),
      0 4px 12px rgb(0 0 0 / 0.35);
  }

  /* Outline: dark glass with a colored border and text */
  .product-badges__badge.product-badges__badge--style-outline {
    border-radius: 999px;
    padding: 0.4em 0.95em;
    color: var(--color-background);
    background: rgb(0 0 0 / 0.6);
    border: 2px solid var(--color-background);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* Holo foil: animated sheen, like a refractor card */
  .product-badges__badge.product-badges__badge--style-foil {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    padding: 0.45em 0.95em;
    border: 1px solid rgb(255 255 255 / 0.55);
    box-shadow: 0 0 14px color-mix(in srgb, var(--color-background) 55%, transparent);
  }

  .product-badges__badge--style-foil::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 25%,
      rgb(255 255 255 / 0.15) 38%,
      rgb(120 230 255 / 0.45) 45%,
      rgb(255 150 245 / 0.45) 52%,
      rgb(255 255 255 / 0.15) 60%,
      transparent 72%
    );
    background-size: 250% 100%;
    animation: product-badge-foil 3.2s ease-in-out infinite;
    pointer-events: none;
  }

  .product-badges__badge--style-foil .product-badges__label {
    position: relative;
    z-index: 1;
  }

  @keyframes product-badge-foil {
    0% { background-position: 150% 0; }
    60%, 100% { background-position: -100% 0; }
  }

  @property --badge-beam-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  /* Neon: glowing tube sign with an occasional flicker */
  .product-badges__badge.product-badges__badge--style-neon {
    font-size: calc(var(--font-size--xs) * 0.88);
    border-radius: 5px;
    padding: 0.33em 0.72em;
    color: #fff;
    background: rgb(0 0 0 / 0.72);
    border: 1.5px solid var(--color-background);
    text-shadow:
      0 0 2px var(--color-background),
      0 0 6px var(--color-background),
      0 0 11px var(--color-background);
    box-shadow:
      0 0 6px var(--color-background),
      0 0 13px color-mix(in srgb, var(--color-background) 60%, transparent),
      inset 0 0 6px color-mix(in srgb, var(--color-background) 70%, transparent);
    animation: product-badge-neon 4s linear infinite;
  }

  @keyframes product-badge-neon {
    0%, 18%, 22%, 25%, 53%, 57%, 100% { opacity: 1; }
    20%, 24%, 55% { opacity: 0.45; }
  }

  /* Rainbow prism: full holographic rainbow that flows across the badge */
  .product-badges__badge.product-badges__badge--style-prism {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    padding: 0.45em 0.95em;
    color: #111;
    background: linear-gradient(115deg, #ff5ec4, #ffd84d, #5effc1, #4dc3ff, #b36bff, #ff5ec4);
    background-size: 300% 100%;
    border: 1px solid rgb(255 255 255 / 0.7);
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.55);
    box-shadow: 0 0 14px rgb(180 120 255 / 0.55);
    animation: product-badge-prism 5s linear infinite;
  }

  @keyframes product-badge-prism {
    to { background-position: 300% 0; }
  }

  /* Chrome: metallic finish in the badge color with a sweeping shine */
  .product-badges__badge.product-badges__badge--style-chrome {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    padding: 0.45em 0.95em;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-background), #fff 45%) 0%,
      var(--color-background) 46%,
      color-mix(in srgb, var(--color-background), #000 35%) 54%,
      color-mix(in srgb, var(--color-background), #fff 15%) 100%
    );
    border: 1px solid rgb(255 255 255 / 0.65);
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.45);
    box-shadow: 0 3px 10px rgb(0 0 0 / 0.4);
  }

  /* Energy beam: a spark of light that races around the border */
  .product-badges__badge.product-badges__badge--style-beam {
    border-radius: 6px;
    padding: 0.4em 0.9em;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--color-background), var(--color-background)) padding-box,
      conic-gradient(
        from var(--badge-beam-angle),
        color-mix(in srgb, var(--color-background), #000 30%) 0% 62%,
        #fff 75%,
        var(--color-background) 82%,
        color-mix(in srgb, var(--color-background), #000 30%) 90%
      ) border-box;
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-background) 55%, transparent);
    animation: product-badge-beam 2.4s linear infinite;
  }

  @keyframes product-badge-beam {
    to { --badge-beam-angle: 360deg; }
  }

  /* Pulse: radar-style ring that keeps pinging out of the badge */
  .product-badges__badge.product-badges__badge--style-pulse {
    position: relative;
    border-radius: 999px;
    padding: 0.45em 1em;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.35);
  }

  .product-badges__badge--style-pulse::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid var(--color-background);
    animation: product-badge-pulse 1.8s ease-out infinite;
    pointer-events: none;
  }

  @keyframes product-badge-pulse {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(1.2, 1.55); opacity: 0; }
  }

  /* Shared sheen for foil and chrome */
  .product-badges__badge--style-chrome::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 30%,
      rgb(255 255 255 / 0.65) 47%,
      transparent 60%
    );
    background-size: 250% 100%;
    animation: product-badge-foil 2.6s ease-in-out infinite;
    pointer-events: none;
  }

  .product-badges__badge--style-chrome .product-badges__label,
  .product-badges__badge--style-prism .product-badges__label {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-badges__badge--style-foil::after,
    .product-badges__badge--style-chrome::after {
      animation: none;
      background-position: 50% 0;
    }

    .product-badges__badge--style-neon,
    .product-badges__badge--style-prism,
    .product-badges__badge--style-beam,
    .product-badges__badge--style-pulse::before {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Quick add"
    },
    {
      "type": "checkbox",
      "id": "quick_add_custom_bg",
      "label": "Customize quick add background",
      "info": "Gives the Pokeball corner button a colored glass background instead of the plain white circle, matching the other homepage sections.",
      "default": true
    },
    {
      "type": "color",
      "id": "quick_add_bg_color",
      "label": "Background color",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.quick_add_custom_bg }}"
    },
    {
      "type": "range",
      "id": "quick_add_bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.quick_add_custom_bg }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}