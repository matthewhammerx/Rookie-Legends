

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="rl-sh section section--page-width color-{{ section.settings.color_scheme }}">
  <div class="rl-sh__glow" aria-hidden="true"></div>
  <div
    class="spacing-style search-page__header search-page__header-{{ section.id }} rl-sh__inner"
    style="
      --horizontal-alignment: {{ section.settings.alignment }};
      --search-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
      --search-heading-size-desktop: {{ section.settings.heading_size }}px;
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <span class="rl-sh__eyebrow"><span class="rl-sh__dot" aria-hidden="true"></span>{{ 'content.search' | t }}</span>

    {%- if search.performed and search.terms != blank -%}
      {% capture heading_text %}<h1>Results for <em>&ldquo;{{ search.terms | escape }}&rdquo;</em></h1>{% endcapture %}
    {%- else -%}
      {% capture heading_text %}<h1>Search the <em>vault</em></h1>{% endcapture %}
    {%- endif -%}

    {% content_for 'block', id: 'heading', type: '_heading', text: heading_text %}

    <p class="rl-sh__sub">
      {%- if search.performed -%}
        {{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}
      {%- else -%}
        Cards, slabs and sealed product. Find it fast.
      {%- endif -%}
    </p>

    {% content_for 'block', id: 'search', type: '_search-input' %}
  </div>
</div>

<script>
  // Live suggestions under the search page's own search pill, using the same
  // predictive search results as the header search.
  (function () {
    var root = document.querySelector('.rl-sh');
    if (!root || root.__rlSuggest) return;
    root.__rlSuggest = true;
    var form = root.querySelector('.search-page-input__parent');
    var input = root.querySelector('input.search-page-input');
    var suggestUrl = '{{ routes.predictive_search_url }}';
    if (!form || !input) return;

    input.setAttribute('autocomplete', 'off');
    var panel = document.createElement('div');
    panel.className = 'rl-sh-suggest';
    panel.hidden = true;
    form.appendChild(panel);

    var timer = null;
    var controller = null;
    var last = '';

    function hide() {
      panel.hidden = true;
    }

    function load(term) {
      if (controller) controller.abort();
      controller = new AbortController();
      var url = new URL(suggestUrl, location.origin);
      url.searchParams.set('q', term);
      url.searchParams.set('resources[limit_scope]', 'each');
      url.searchParams.set('section_id', 'predictive-search');
      fetch(url.toString(), { signal: controller.signal })
        .then(function (r) { return r.ok ? r.text() : ''; })
        .then(function (html) {
          if (!html || input.value.trim() !== term) return;
          panel.innerHTML = html;
          // The search button inside the results goes to the full results page
          panel.querySelectorAll('button[ref="viewAllButton"], .predictive-search__search-button').forEach(function (b) { b.remove(); });
          panel.hidden = !panel.querySelector('a, [role="option"]');
        })
        .catch(function () {});
    }

    input.addEventListener('input', function () {
      var term = input.value.trim();
      clearTimeout(timer);
      if (term.length < 2) { last = ''; hide(); return; }
      if (term === last) return;
      timer = setTimeout(function () { last = term; load(term); }, 200);
    });

    input.addEventListener('focus', function () {
      if (panel.innerHTML && input.value.trim().length >= 2) panel.hidden = false;
    });

    document.addEventListener('click', function (e) {
      if (!form.contains(e.target)) hide();
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') hide();
    });
  })();
</script>

<style>
  /* ---- Live suggestions dropdown under the pill ---- */
  .rl-sh .search-page-input__parent {
    position: relative;
    z-index: 5;
  }

  .rl-sh-suggest {
    --color-foreground: rgb(255 255 255 / 1);
    --color-foreground-rgb: 255 255 255;
    --color-background: rgb(20 14 24 / 1);
    --color-background-rgb: 20 14 24;
    --color-border: rgb(255 255 255 / 0.1);

    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    max-height: min(70vh, 640px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px 6px 14px;
    text-align: left;
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 24px;
    background: rgb(20 14 24 / 0.94);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.55);
    animation: rl-sh-drop 0.22s cubic-bezier(0.22, 0.9, 0.3, 1) both;
  }

  .rl-sh-suggest[hidden] {
    display: none;
  }

  .rl-sh-suggest :is(.predictive-search-results__inner, .predictive-search-dropdown, .predictive-search-results__products) {
    max-height: none;
    overflow: visible;
    background: transparent;
  }

  .rl-sh-suggest .predictive-search-results__title {
    margin: 12px 14px 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
    text-align: left !important;
  }

  .rl-sh-suggest .predictive-search-results__card--product .resource-card__media {
    border-radius: 12px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.05);
  }

  .rl-sh-suggest .price,
  .rl-sh-suggest .price * {
    color: #ff2fb1;
  }

  @keyframes rl-sh-drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  html.rl-lite .rl-sh-suggest {
    background: rgb(20 14 24 / 0.98);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Rookie Legends search hero: dark glow, eyebrow pill, big heading, glass pill */
  #MainContent:has(.rl-sh) {
    background-color: #000;
  }

  /* Sits above the results so the suggestions dropdown can hang over them */
  .shopify-section:has(.rl-sh) {
    position: relative;
    z-index: 3;
  }

  .rl-sh.section {
    overflow: visible !important;
  }

  .rl-sh {
    position: relative;
    z-index: 3;
    padding-top: calc(var(--header-height, 64px) + 44px);
    padding-bottom: 34px;
    background: #000;
    color: #fff;
  }

  /* Under a hero banner: no header gap, no black slab over the hero */
  .shopify-section:not(:first-child) .rl-sh {
    padding-top: 28px;
    background: transparent;
  }

  .shopify-section:not(:first-child) .rl-sh__glow {
    display: none;
  }

  .rl-sh__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(42% 60% at 18% 30%, rgb(235 0 202 / 0.32), transparent 70%),
      radial-gradient(40% 55% at 85% 20%, rgb(110 60 255 / 0.28), transparent 70%),
      linear-gradient(to bottom, transparent 55%, #000);
  }

  /* Everything centred in the middle of the page */
  .rl-sh__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    --horizontal-alignment: center;
  }

  .rl-sh__inner > * {
    margin-inline: auto;
    text-align: center;
    justify-content: center;
  }

  .rl-sh__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rl-sh__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 10px rgb(255 47 177 / 0.95);
  }

  .search-page__header-{{ section.id }} h1,
  .search-page__header-{{ section.id }} h3 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: calc(var(--search-heading-size-mobile) * 1.5);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
    overflow-wrap: anywhere;
  }

  .search-page__header-{{ section.id }} h1 em {
    font-style: normal;
    background: linear-gradient(90deg, #ff2fb1, #b44cff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .rl-sh__sub {
    margin: -4px 0 6px;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 0.6);
  }

  .rl-sh__inner > :not(.search-page-input__parent) {
    width: auto;
    max-width: 100%;
  }

  .rl-sh__inner :is(h1, h3, p) {
    text-align: center !important;
  }

  /* Search pill: wide and centred (the block otherwise sizes to 50%) */
  .rl-sh__inner .search-page-input__parent {
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
  }

  .rl-sh__inner .search-page-input__parent > * {
    width: 100%;
    max-width: 100% !important;
  }

  @media screen and (min-width: 750px) {
    .rl-sh {
      padding-top: calc(var(--header-height, 80px) + 70px);
      padding-bottom: 46px;
    }

    .search-page__header-{{ section.id }} h1,
    .search-page__header-{{ section.id }} h3 {
      font-size: calc(var(--search-heading-size-desktop) * 1.6);
    }
  }


  .search-page__header-{{ section.id }} search-page-input-component {
    background: linear-gradient(165deg, rgba(40, 20, 34, 0.85), rgba(20, 10, 18, 0.75));
    border: 1px solid rgba(235, 0, 202, 0.4);
    border-radius: 999px;
    box-shadow: 0 0 24px -6px rgba(235, 0, 202, 0.5);
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .search-page__header-{{ section.id }} search-page-input-component:focus-within {
    border-color: rgba(235, 0, 202, 0.85);
    box-shadow: 0 0 28px -4px rgba(235, 0, 202, 0.75);
  }

  .search-page__header-{{ section.id }} .search-page-input {
    background: transparent;
    border: none;
    border-radius: 999px;
    color: #ffffff;
  }

  .search-page__header-{{ section.id }} .search-page-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .search-page__header-{{ section.id }} .search__icon svg {
    color: #eb00ca;
  }

  .search-page__header-{{ section.id }} .search__reset-button {
    color: #eb00ca;
  }

  .search-page__header-{{ section.id }} .search__reset-button:hover {
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "t:names.search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading size"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 20,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}