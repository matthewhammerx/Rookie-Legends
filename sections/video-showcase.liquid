{% liquid
  assign accent = section.settings.accent_color
  assign fade_opacity_decimal = section.settings.fade_opacity | times: 1.0 | divided_by: 100
  assign slide_count = section.blocks.size
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="video-showcase-{{ section.id }} video-showcase section section--full-width color-{{ section.settings.color_scheme }}"
  data-vs-root
>
  <div class="video-showcase__ambient" aria-hidden="true"></div>

  {% if section.settings.heading != blank %}
    <div class="video-showcase__head">
      <h2 class="video-showcase__heading" data-text="{{ section.settings.heading | escape }}">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  {%- comment -%}
    Carousel: one element per video, positioned with transforms around the
    active index (wraps endlessly, no cloned slides, no scroll jumping).
    Only the centered video plays, and only while the section is on screen.
  {%- endcomment -%}
  <div
    class="video-showcase__carousel"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.heading | default: 'Videos' | escape }}"
    tabindex="0"
  >
    <div class="video-showcase__stage" data-vs-stage>
      {% for block in section.blocks %}
        {% liquid
          assign video_id = block.settings.video.id | default: block.settings.video_url.id
          assign mp4_source = block.settings.video.sources | where: 'format', 'mp4' | first
          assign fallback_source = block.settings.video.sources | first
        %}
        <div
          class="video-showcase__slide{% if forloop.first %} is-active{% endif %}"
          data-vs-slide
          data-index="{{ forloop.index0 }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ slide_count }}"
          {{ block.shopify_attributes }}
        >
          <div class="video-showcase__frame">
            <div class="video-showcase__media">
              {% if block.settings.video != null %}
                <video
                  data-vs-video
                  data-src="{{ mp4_source.url | default: fallback_source.url }}"
                  {% if block.settings.video.preview_image %}
                    poster="{{ block.settings.video.preview_image | image_url: width: 800 }}"
                  {% endif %}
                  muted
                  playsinline
                  loop
                  preload="none"
                ></video>
              {% elsif block.settings.video_url != null %}
                {% if block.settings.video_url.type == 'youtube' %}
                  <iframe
                    data-vs-embed
                    title="Video {{ forloop.index }}"
                    data-play-src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&mute=1&autoplay=1&controls=0&playsinline=1&loop=1&playlist={{ video_id }}"
                    data-pause-src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&mute=1&autoplay=0&controls=0&playsinline=1&loop=1&playlist={{ video_id }}"
                    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                {% else %}
                  <iframe
                    data-vs-embed
                    title="Video {{ forloop.index }}"
                    data-play-src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1&muted=1&loop=1&background=1"
                    data-pause-src="https://player.vimeo.com/video/{{ video_id }}?autoplay=0&muted=1&loop=1&background=1"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                {% endif %}
              {% endif %}
            </div>

            <div class="video-showcase__controls">
              <button type="button" class="video-showcase__ctrl is-muted" data-vs-mute aria-label="Sound on or off">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 9v6h4l5 4V5L8 9H4Z"/>
                  <g data-mute-x><path d="M17 9l4 6M21 9l-4 6"/></g>
                  <g data-mute-waves><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/></g>
                </svg>
              </button>
              <button type="button" class="video-showcase__ctrl" data-vs-play aria-label="Play or pause">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon data-icon-play points="7,4 20,12 7,20"/>
                  <g data-icon-pause><rect x="5" y="4" width="5" height="16" rx="1"/><rect x="14" y="4" width="5" height="16" rx="1"/></g>
                </svg>
              </button>
            </div>

            {% if block.settings.caption != blank %}
              <div class="video-showcase__caption video-showcase__caption--{{ block.settings.caption_position }}">
                {{ block.settings.caption }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if slide_count > 1 %}
      <button type="button" class="video-showcase__nav video-showcase__nav--prev" data-vs-prev aria-label="Previous video">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="video-showcase__nav video-showcase__nav--next" data-vs-next aria-label="Next video">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <div class="video-showcase__dots">
        {% for block in section.blocks %}
          <button
            type="button"
            class="video-showcase__dot{% if forloop.first %} is-active{% endif %}"
            data-vs-dot="{{ forloop.index0 }}"
            aria-label="Go to video {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .video-showcase-{{ section.id }} {
    --vs-card-w: 62vw;
    --vs-gap: {{ section.settings.gap }}px;
    --vs-step: calc(var(--vs-card-w) + var(--vs-gap));
    --vs-drag: 0px;

    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .video-showcase-{{ section.id }} {
      --vs-card-w: 260px;
    }
  }

  .video-showcase-{{ section.id }} .video-showcase__ambient {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, {{ fade_opacity_decimal }}) 0%,
        transparent {{ section.settings.fade_size }}%
      ),
      radial-gradient(55% 90% at 50% 30%, {{ accent }}22, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .video-showcase-{{ section.id }} .video-showcase__head {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-inline: 20px;
    margin-bottom: 24px;
  }

  .video-showcase-{{ section.id }} .video-showcase__heading {
    font-family: var(--font-heading--family, inherit);
    font-weight: 800;
    font-size: {{ section.settings.heading_size_mobile }}px;
    margin: 0;
    line-height: 0.95;
    text-transform: uppercase;
    /* White with an offset pink outline echo, like the collection titles */
    position: relative;
    isolation: isolate;
    color: #fff;
  }

  .video-showcase-{{ section.id }} .video-showcase__heading::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 47 177 / 0.85);
    transform: translate(0.07em, 0.07em);
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .video-showcase-{{ section.id }} .video-showcase__heading {
      font-size: {{ section.settings.heading_size }}px;
    }
  }

  .video-showcase-{{ section.id }} .video-showcase__carousel {
    position: relative;
    z-index: 1;
    outline: none;
  }

  .video-showcase-{{ section.id }} .video-showcase__stage {
    position: relative;
    z-index: 1;
    height: calc(var(--vs-card-w) * 14 / 9);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .video-showcase-{{ section.id }} .video-showcase__slide {
    --o: 0;

    position: absolute;
    top: 0;
    left: 50%;
    width: var(--vs-card-w);
    margin-left: calc(var(--vs-card-w) / -2);
    transform: translateX(calc(var(--o) * var(--vs-step) + var(--vs-drag))) scale(0.9);
    transition:
      transform 0.55s cubic-bezier(0.22, 0.8, 0.26, 1),
      opacity 0.4s ease;
    cursor: pointer;
  }

  .video-showcase-{{ section.id }} .video-showcase__slide.is-active {
    transform: translateX(calc(var(--o) * var(--vs-step) + var(--vs-drag))) scale(1);
    cursor: default;
    z-index: 2;
  }

  .video-showcase-{{ section.id }} .video-showcase__slide.is-off {
    opacity: 0;
    pointer-events: none;
  }

  .video-showcase-{{ section.id }} .video-showcase__stage.is-dragging .video-showcase__slide,
  .video-showcase-{{ section.id }} .video-showcase__slide.no-anim {
    transition: none;
  }

  .video-showcase-{{ section.id }} .video-showcase__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 14;
    border-radius: {{ section.settings.card_radius }}px;
    background: #050505;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 40px -28px rgba(0, 0, 0, 0.7);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .video-showcase-{{ section.id }} .video-showcase__slide.is-active .video-showcase__frame {
    border-color: {{ accent }}66;
    box-shadow:
      0 30px 60px -30px rgba(0, 0, 0, 0.8),
      0 0 40px -12px {{ accent }}66;
  }

  /* Side cards: a dark layer instead of a filter over live video */
  .video-showcase-{{ section.id }} .video-showcase__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0.6);
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .video-showcase-{{ section.id }} .video-showcase__slide.is-active .video-showcase__frame::after {
    opacity: 0;
  }

  .video-showcase-{{ section.id }} .video-showcase__media,
  .video-showcase-{{ section.id }} .video-showcase__media video,
  .video-showcase-{{ section.id }} .video-showcase__media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    background: #050505;
  }

  .video-showcase-{{ section.id }} .video-showcase__media iframe {
    pointer-events: none;
  }

  .video-showcase-{{ section.id }} .video-showcase__controls {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .video-showcase-{{ section.id }} .video-showcase__slide.is-active .video-showcase__controls {
    opacity: 1;
    pointer-events: auto;
  }

  .video-showcase-{{ section.id }} .video-showcase__ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 50%;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.18);
    cursor: pointer;
  }

  .video-showcase-{{ section.id }} .video-showcase__ctrl svg {
    width: 16px;
    height: 16px;
  }

  .video-showcase-{{ section.id }} [data-vs-mute].is-muted [data-mute-waves],
  .video-showcase-{{ section.id }} [data-vs-mute]:not(.is-muted) [data-mute-x],
  .video-showcase-{{ section.id }} [data-vs-play] [data-icon-pause],
  .video-showcase-{{ section.id }} [data-vs-play].is-playing [data-icon-play] {
    display: none;
  }

  .video-showcase-{{ section.id }} [data-vs-play].is-playing [data-icon-pause] {
    display: block;
  }

  .video-showcase-{{ section.id }} .video-showcase__caption {
    position: absolute;
    left: 14px;
    right: 14px;
    z-index: 3;
    font-family: var(--font-heading--family, inherit);
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.2;
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.75);
    pointer-events: none;
  }

  .video-showcase-{{ section.id }} .video-showcase__caption--bottom {
    bottom: 16px;
  }

  .video-showcase-{{ section.id }} .video-showcase__caption--top {
    top: 54px;
  }

  .video-showcase-{{ section.id }} .video-showcase__nav {
    position: absolute;
    top: calc(var(--vs-card-w) * 7 / 9);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    padding: 0;
    border-radius: 50%;
    color: #fff;
    background: rgba(12, 10, 14, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.16);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .video-showcase-{{ section.id }} .video-showcase__nav--prev {
    left: calc(50% - var(--vs-card-w) / 2 - 64px);
  }

  .video-showcase-{{ section.id }} .video-showcase__nav--next {
    right: calc(50% - var(--vs-card-w) / 2 - 64px);
  }

  .video-showcase-{{ section.id }} .video-showcase__nav svg {
    width: 20px;
    height: 20px;
  }

  .video-showcase-{{ section.id }} .video-showcase__nav:hover {
    border-color: {{ accent }}aa;
    transform: scale(1.06);
  }

  @media (max-width: 749px) {
    .video-showcase-{{ section.id }} .video-showcase__nav {
      display: none;
    }
  }

  .video-showcase-{{ section.id }} .video-showcase__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
  }

  .video-showcase-{{ section.id }} .video-showcase__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .video-showcase-{{ section.id }} .video-showcase__dot.is-active {
    width: 24px;
    background: {{ accent }};
  }

  .video-showcase-{{ section.id }} .video-showcase__carousel:focus-visible .video-showcase__slide.is-active .video-showcase__frame {
    outline: 2px solid {{ accent }};
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-showcase-{{ section.id }} .video-showcase__slide {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.video-showcase-{{ section.id }}');
    if (!root || root.dataset.vsReady) return;
    root.dataset.vsReady = 'true';

    var stage = root.querySelector('[data-vs-stage]');
    var carousel = root.querySelector('.video-showcase__carousel');
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-vs-slide]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-vs-dot]'));
    var n = slides.length;
    if (!n) return;

    var active = 0;
    var inView = false;
    var soundOn = false;
    var userPaused = {};
    var prevOffsets = [];

    function isLite() {
      return !!(window.rlIsLite && window.rlIsLite());
    }

    function sideCount() {
      var max = window.innerWidth >= 750 ? 2 : 1;
      return Math.min(max, Math.floor((n - 1) / 2));
    }

    /* ---------- media ---------- */
    function media(slide) {
      return {
        video: slide.querySelector('[data-vs-video]'),
        embed: slide.querySelector('[data-vs-embed]'),
        playBtn: slide.querySelector('[data-vs-play]'),
      };
    }

    function ensureSrc(slide) {
      var m = media(slide);
      if (m.video && !m.video.getAttribute('src') && m.video.dataset.src) {
        m.video.src = m.video.dataset.src;
      }
      if (m.embed && !m.embed.getAttribute('src')) {
        m.embed.src = m.embed.dataset.pauseSrc;
      }
    }

    function setPlaying(slide, playing) {
      var btn = media(slide).playBtn;
      if (btn) btn.classList.toggle('is-playing', playing);
    }

    function play(slide) {
      var m = media(slide);
      ensureSrc(slide);
      if (m.video) {
        m.video.muted = !soundOn;
        var p = m.video.play();
        if (p && p.catch) {
          p.catch(function (err) {
            if (err && err.name === 'NotAllowedError' && window.rlLite) window.rlLite('autoplay-blocked');
          });
        }
      }
      if (m.embed && m.embed.getAttribute('src') !== m.embed.dataset.playSrc) {
        m.embed.src = m.embed.dataset.playSrc;
        setPlaying(slide, true);
      }
    }

    function pause(slide) {
      var m = media(slide);
      if (m.video && !m.video.paused) m.video.pause();
      if (m.embed && m.embed.getAttribute('src') === m.embed.dataset.playSrc) {
        m.embed.src = m.embed.dataset.pauseSrc;
        setPlaying(slide, false);
      }
    }

    // The play/pause icon follows what the video is really doing
    slides.forEach(function (slide) {
      var video = media(slide).video;
      if (!video) return;
      video.addEventListener('playing', function () {
        setPlaying(slide, true);
      });
      video.addEventListener('pause', function () {
        setPlaying(slide, false);
      });
    });

    function syncPlayback() {
      slides.forEach(function (slide, i) {
        var shouldPlay = i === active && inView && !userPaused[i] && (!isLite() || userPaused[i] === false);
        if (shouldPlay) play(slide);
        else pause(slide);
      });
      // Warm up the next video so switching feels instant
      if (inView && n > 1) {
        var next = slides[(active + 1) % n];
        var nv = media(next).video;
        if (nv && !nv.getAttribute('src') && nv.dataset.src) {
          nv.preload = 'metadata';
          nv.src = nv.dataset.src;
        }
      }
    }

    /* ---------- layout ---------- */
    function offsetOf(i) {
      var half = Math.floor(n / 2);
      return ((((i - active + half) % n) + n) % n) - half;
    }

    function layout() {
      var side = sideCount();
      slides.forEach(function (slide, i) {
        var o = offsetOf(i);
        // A card wrapping around from one end to the other shouldn't fly across
        var jump = prevOffsets[i] !== undefined && Math.abs(o - prevOffsets[i]) > 1;
        if (jump) slide.classList.add('no-anim');
        slide.style.setProperty('--o', o);
        slide.classList.toggle('is-active', o === 0);
        slide.classList.toggle('is-off', Math.abs(o) > side);
        slide.setAttribute('aria-hidden', o === 0 ? 'false' : 'true');
        slide.style.zIndex = String(10 - Math.abs(o));
        prevOffsets[i] = o;
      });
      // Re-enable transitions after the wrap jump has been applied
      stage.offsetWidth;
      slides.forEach(function (slide) {
        slide.classList.remove('no-anim');
      });
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === active);
        dot.setAttribute('aria-current', i === active ? 'true' : 'false');
      });
    }

    function goTo(index) {
      var next = ((index % n) + n) % n;
      if (next === active) return;
      delete userPaused[next];
      active = next;
      layout();
      syncPlayback();
    }

    /* ---------- controls ---------- */
    root.addEventListener('click', function (e) {
      if (dragMoved) return;
      var t = e.target;
      if (t.closest('[data-vs-prev]')) return goTo(active - 1);
      if (t.closest('[data-vs-next]')) return goTo(active + 1);
      var dot = t.closest('[data-vs-dot]');
      if (dot) return goTo(parseInt(dot.dataset.vsDot, 10));

      var playBtn = t.closest('[data-vs-play]');
      if (playBtn) {
        var slide = playBtn.closest('[data-vs-slide]');
        var i = slides.indexOf(slide);
        if (playBtn.classList.contains('is-playing')) {
          userPaused[i] = true;
          pause(slide);
        } else {
          userPaused[i] = false;
          play(slide);
        }
        return;
      }

      var muteBtn = t.closest('[data-vs-mute]');
      if (muteBtn) {
        soundOn = !soundOn;
        root.querySelectorAll('[data-vs-mute]').forEach(function (b) {
          b.classList.toggle('is-muted', !soundOn);
        });
        var v = media(slides[active]).video;
        if (v) v.muted = !soundOn;
        return;
      }

      // Tap a side card to bring it to the center
      var tapped = t.closest('[data-vs-slide]');
      if (tapped && !tapped.classList.contains('is-active')) goTo(slides.indexOf(tapped));
    });

    carousel.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(active - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(active + 1);
      }
    });

    /* ---------- swipe / drag ---------- */
    var dragStartX = null;
    var dragStartY = 0;
    var dragX = 0;
    var dragMoved = false;
    var dragLocked = false;

    stage.addEventListener('pointerdown', function (e) {
      if (e.button !== 0 || e.target.closest('button')) return;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragX = 0;
      dragMoved = false;
      dragLocked = false;
    });

    window.addEventListener('pointermove', function (e) {
      if (dragStartX === null) return;
      var dx = e.clientX - dragStartX;
      var dy = e.clientY - dragStartY;
      if (!dragLocked) {
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        // Mostly vertical: let the page scroll
        if (Math.abs(dy) > Math.abs(dx)) {
          dragStartX = null;
          return;
        }
        dragLocked = true;
        dragMoved = true;
        stage.classList.add('is-dragging');
      }
      dragX = dx;
      root.style.setProperty('--vs-drag', dx + 'px');
    });

    function endDrag() {
      if (dragStartX === null) return;
      dragStartX = null;
      if (!dragLocked) return;
      stage.classList.remove('is-dragging');
      root.style.setProperty('--vs-drag', '0px');
      var threshold = Math.min(80, stage.offsetWidth * 0.12);
      if (dragX <= -threshold) goTo(active + 1);
      else if (dragX >= threshold) goTo(active - 1);
      // Swallow the click that follows a drag
      setTimeout(function () {
        dragMoved = false;
      }, 0);
    }

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    /* ---------- visibility / power ---------- */
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        function (entries) {
          inView = entries[0].isIntersecting;
          syncPlayback();
        },
        { threshold: 0.35 }
      ).observe(stage);
    } else {
      inView = true;
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) slides.forEach(pause);
      else syncPlayback();
    });

    document.addEventListener('rl:lite', syncPlayback);

    var resizeTimer = null;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 150);
    });

    layout();
    syncPlayback();
  })();
</script>

