/* Keep mobile drawer above flash sale bar / entire website */
.header-section:has(#Details-menu-drawer-container[open]),
#header-component:has(#Details-menu-drawer-container[open]),
.header:has(#Details-menu-drawer-container[open]),
.header-drawer,
.menu-drawer-container[open],
.menu-drawer-container[open] .menu-drawer,
.menu-drawer-container[open] .menu-drawer__backdrop {
  z-index: 999999 !important;
}

/*
  Force the dark/pink brand look here too, regardless of the drawer's
  own "color scheme" setting, matching the frosted-glass dark look
  used by the nav dropdowns and the search modal.
*/
.menu-drawer {
  --color-background: rgb(10 10 12 / 1) !important;
  --color-background-rgb: 10 10 12 !important;
  --color-foreground: rgb(255 255 255 / 1) !important;
  --color-foreground-rgb: 255 255 255 !important;
  --color-border: rgb(255 255 255 / 0.14) !important;
  --color-border-rgb: 255 255 255 !important;
  --color-primary: rgb(255 47 177 / 1) !important;
  --color-primary-rgb: 255 47 177 !important;
  --color-primary-hover: rgb(235 0 202 / 1) !important;
  --color-primary-hover-rgb: 235 0 202 !important;
  background: rgba(8, 8, 11, 0.94) !important;
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-radius: 0 24px 24px 0 !important;
}

.menu-drawer {
  background: rgba(8, 8, 11, 0.3) !important;
}

.menu-drawer .mobile-sell-btn,
.menu-drawer .mobile-sell-wrapper:first-of-type .mobile-sell-btn {
  background: rgba(255, 47, 177, 0.14) !important;
  border: 1px solid rgba(255, 47, 177, 0.55) !important;
  color: #fff !important;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.menu-drawer .mobile-sell-btn:hover {
  background: rgba(255, 47, 177, 0.24) !important;
  border-color: rgba(255, 47, 177, 0.85) !important;
}

/* Shrink the collection-tile labels (e.g. "ACRYLIC", "FRAME") in the
   drawer's image-grid submenus, without touching the top-level
   accordion headers like "ACCESSORIES". */
.menu-drawer__menu-item:has(> .menu-drawer__link-image) .menu-drawer__menu-item-text {
  display: none;
}

  /* =====================================================================
     Rookie Legends floating glass menu (.rl-fm)
     The .menu-drawer panel becomes a transparent floating container that
     holds a glass pill bar, a glass card and the currency pill.
     ===================================================================== */
  .menu-drawer:has(.rl-fm) {
    --rl-pink: #ff2fb1;
    --rl-glass: rgb(24 17 29 / 0.62);
    --rl-glass-border: rgb(255 255 255 / 0.12);

    /* --rl-fm-top = over the header row (set by the script on open) */
    top: var(--rl-fm-top, calc(10px + env(safe-area-inset-top, 0px))) !important;
    left: 10px !important;
    right: 10px;
    width: auto !important;
    max-width: 480px !important;
    height: auto !important;
    max-height: calc(100dvh - var(--rl-fm-top, 10px) - 10px);
    padding: 0 !important;
    gap: 8px;
    overflow: visible !important;
    color: #fff;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    opacity: 0;
    transform: translateY(-10px) scale(0.98) !important;
    transform-origin: top center;
    transition:
      opacity 0.28s ease,
      transform 0.38s cubic-bezier(0.22, 0.9, 0.3, 1),
      visibility 0.38s ease !important;
  }

  .menu-open > .menu-drawer:has(.rl-fm) {
    opacity: 1;
    transform: none !important;
  }

  .menu-drawer:has(.rl-fm) > .menu-drawer__close-button,
  .menu-drawer:has(.rl-fm) .mobile-sell-buttons {
    display: none !important;
  }

  /* While open, the menu bar takes the header's place: hide the logo, icons and burger under it */
  .header__columns:has(#Details-menu-drawer-container[open] .rl-fm) > .header__column > :not(:has(#Details-menu-drawer-container)),
  #Details-menu-drawer-container[open]:has(.rl-fm) > summary {
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  /* The page canvas is white under the dark sections. While the menu locks
     scrolling, iPhone Safari shows its toolbar again and uncovers it at the
     bottom, so paint it dark while the menu is open. */
  html:has(#Details-menu-drawer-container[open] .rl-fm),
  html:has(#Details-menu-drawer-container[open] .rl-fm) body {
    background-color: #0a0a0c !important;
  }

  /* Tap anywhere outside the menu to close it */
  .menu-drawer-container[open]:has(.rl-fm) .menu-drawer__backdrop {
    position: fixed;
    inset: 0;
    /* Leave the announcement bar undimmed; the menu bar replaces the header row */
    top: var(--rl-fm-shade, 0px);
    z-index: 999998 !important;
    background: rgb(0 0 0 / 0.45) !important;
    animation: rl-fm-fade 0.28s ease both;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
  }

  .rl-fm {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 0;
    padding: 0 !important;
  }

  /* ---- Pill bar ---- */
  .rl-fm__bar {
    display: grid;
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    align-items: center;
    gap: 8px;
    height: 54px;
    padding: 0 7px;
    border: 1px solid var(--rl-glass-border);
    border-radius: 999px;
    /* A touch more solid than the card: it sits over the header */
    background: rgb(24 17 29 / 0.86);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    backdrop-filter: blur(22px) saturate(160%);
    box-shadow: 0 12px 34px rgb(0 0 0 / 0.35);
  }

  .rl-fm__bar-side {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .rl-fm__bar-side--end {
    justify-content: flex-end;
  }

  .rl-fm__bar-center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 0;
  }

  .rl-fm__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px rgb(255 47 177 / 0.9);
  }

  .rl-fm__bar-title {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-heading--family, inherit);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rl-fm__bar-chip {
    padding: 8px 14px;
    border-radius: 999px;
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .rl-fm__icon-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: transparent;
    cursor: pointer;
  }

  .rl-fm__icon-btn svg {
    width: 20px;
    height: 20px;
  }

  .rl-fm__back {
    margin-left: -8px;
  }

  .rl-fm__icon-btn[hidden],
  .rl-fm__dot[hidden] {
    display: none;
  }

  /* ---- Glass card ---- */
  .rl-fm__card {
    min-height: 0;
    max-height: calc(100dvh - var(--rl-fm-top, 10px) - 10px - 54px - 8px - 62px);
    padding: 10px;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--rl-glass-border);
    border-radius: 28px;
    background: var(--rl-glass);
    -webkit-backdrop-filter: blur(26px) saturate(160%);
    backdrop-filter: blur(26px) saturate(160%);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.4);
    scrollbar-width: none;
  }

  .rl-fm__card::-webkit-scrollbar {
    display: none;
  }

  .rl-fm__view[hidden] {
    display: none;
  }

  .rl-fm__view.is-active {
    animation: rl-fm-view 0.32s cubic-bezier(0.22, 0.9, 0.3, 1);
  }

  .rl-fm__view.is-active.from-left {
    animation-name: rl-fm-view-back;
  }

  @keyframes rl-fm-view {
    from { opacity: 0; transform: translateX(14px); }
  }

  @keyframes rl-fm-view-back {
    from { opacity: 0; transform: translateX(-14px); }
  }

  .rl-fm__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  details.menu-open .rl-fm__list > li {
    animation: rl-fm-row 0.38s cubic-bezier(0.22, 0.9, 0.3, 1) both;
    animation-delay: calc(var(--i, 0) * 30ms + 80ms);
  }

  @keyframes rl-fm-row {
    from { opacity: 0; transform: translateY(6px); }
  }

  @keyframes rl-fm-fade {
    from { opacity: 0; }
  }

  .rl-fm__row {
    display: grid;
    grid-template-columns: 88px 1fr 18px;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 8px;
    border: 0;
    border-radius: 18px;
    color: #fff;
    background: transparent;
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .rl-fm__row:hover,
  .rl-fm__row:focus-visible,
  .rl-fm__row:active {
    background: rgb(255 255 255 / 0.07);
    outline: none;
  }

  .rl-fm__thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.07);
  }

  .rl-fm__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rl-fm__thumb-letter {
    font-family: var(--font-heading--family, inherit);
    font-size: 1.6rem;
    font-weight: 800;
    color: rgb(255 255 255 / 0.85);
  }

  .rl-fm__thumb--sell {
    color: #fff;
    background: linear-gradient(135deg, rgb(255 47 177 / 0.35), rgb(139 92 255 / 0.25));
  }

  .rl-fm__thumb--sell svg {
    width: 24px;
    height: 24px;
  }

  .rl-fm__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    min-width: 0;
  }

  .rl-fm__eyebrow {
    color: rgb(255 255 255 / 0.55);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rl-fm__chip {
    padding: 2px 9px;
    border-radius: 999px;
    color: #fff;
    background: var(--rl-pink);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .rl-fm__title {
    max-width: 100%;
    overflow: hidden;
    font-family: var(--font-heading--family, inherit);
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rl-fm__row[aria-current='page'] .rl-fm__title {
    color: var(--rl-pink);
  }

  .rl-fm__chev {
    width: 18px;
    height: 18px;
    color: rgb(255 255 255 / 0.45);
  }

  .rl-fm__all {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    padding: 14px 12px 6px;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }

  .rl-fm__all svg {
    width: 16px;
    height: 16px;
  }

  /* ---- Currency pill under the card ---- */
  .menu-drawer:has(.rl-fm) .menu-drawer__utility-links {
    align-self: flex-start;
    margin: 0 !important;
    padding: 4px 14px !important;
    border: 1px solid var(--rl-glass-border);
    border-radius: 999px;
    background: var(--rl-glass);
    -webkit-backdrop-filter: blur(22px);
    backdrop-filter: blur(22px);
  }

  /* Lite mode: solid glass, no live blur */
  html.rl-lite :is(.rl-fm__bar, .rl-fm__card),
  html.rl-lite .menu-drawer:has(.rl-fm) .menu-drawer__utility-links {
    background: rgb(20 14 24 / 0.96);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rl-fm__view.is-active,
    details.menu-open .rl-fm__list > li,
    .menu-drawer-container[open]:has(.rl-fm) .menu-drawer__backdrop {
      animation: none;
    }
  }
{% endstylesheet %}