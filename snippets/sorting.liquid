{%- doc -%}
  Renders the sorting component.

  @param {object} results - The results of the search
  @param {string} sort_by - The current sort by
  @param {string} filter_style - The filter style
  @param {string} [suffix] - { 'desktop' | 'mobile' | 'overflow' } Used on `form` attributes to connect inputs to a form[id]
  @param {string} [sort_position] - { 'desktop' | 'mobile' } Used in a data-testID selector for automated testing
  @param {boolean} should_use_select_on_mobile - Whether to use a select element for the sorting component on mobile
  @param {string} section_id - The section ID
  @param {boolean} [deck] - Rendered inside the .rl-deck control bar (adds menu titles)
  @param {object} [price_filter] - Price range filter; with deck, adds a price range picker to the menu
{%- enddoc -%}

<sorting-filter-component
  class="sorting-filter{% if filter_style == 'horizontal' %} sorting-filter__horizontal{% endif %}"
  on:change="/updateFilterAndSorting"
  on:keydown="/handleKeyDown"
  {% if sort_position != blank %}
    data-testid="sorting-filter-component-{{ sort_position }}"
  {% endif %}
  data-should-use-select-on-mobile="{{ should_use_select_on_mobile }}"
>
  {% liquid
    # Price range picker (whole currency units) for the deck menu
    assign rl_price = false
    if deck and price_filter != blank and price_filter.range_max > 0
      assign rl_price = true
      assign rl_symbol = cart.currency.symbol | default: '$'
      assign rl_max = price_filter.range_max | plus: 99 | divided_by: 100
      assign rl_lo = ''
      assign rl_hi = ''
      if price_filter.min_value.value != null
        assign rl_lo = price_filter.min_value.value | divided_by: 100
      endif
      if price_filter.max_value.value != null
        assign rl_hi = price_filter.max_value.value | plus: 99 | divided_by: 100
      endif
      assign rl_chip = ''
      assign rl_lo_fmt = rl_lo | times: 100 | money_without_trailing_zeros
      assign rl_hi_fmt = rl_hi | times: 100 | money_without_trailing_zeros
      if rl_lo != '' and rl_hi != ''
        assign rl_chip = rl_lo_fmt | append: '–' | append: rl_hi_fmt
      elsif rl_lo != ''
        assign rl_chip = rl_lo_fmt | append: '+'
      elsif rl_hi != ''
        assign rl_chip = 'Under ' | append: rl_hi_fmt
      endif
    elsif deck
      # Markets where Shopify doesn't offer a price filter (anything but the
      # store's main market): same picker, filtering the loaded grid in the
      # browser by each item's local price (data-rl-cost on the grid items).
      assign rl_top = 0
      for rl_product in results.products
        if rl_product.price > rl_top
          assign rl_top = rl_product.price
        endif
      endfor
      if rl_top > 0
        assign rl_price = true
        assign rl_local = true
        assign rl_symbol = cart.currency.symbol | default: '$'
        assign rl_top = rl_top | plus: 99 | divided_by: 100
        assign rl_max = rl_top
        assign rl_rounded = false
        assign rl_steps = '10,20,25,50,100,150,200,250,500,1000,1500,2000,2500,5000,10000,15000,20000,25000,50000,100000,150000,200000,250000,500000,1000000,2000000,5000000' | split: ','
        for n in rl_steps
          assign rl_n = n | plus: 0
          if rl_rounded == false and rl_n >= rl_top
            assign rl_max = rl_n
            assign rl_rounded = true
          endif
        endfor
        assign rl_lo = ''
        assign rl_hi = ''
        assign rl_chip = ''
      endif
    endif

    assign default_sort_by = results.default_sort_by
    for option in results.sort_options
      if option.value == sort_by
        assign status = option.name
      endif
    endfor
  %}

  <div class="sorting-filter__container {% if should_use_select_on_mobile %} desktop:hidden {% else %} hidden {% endif %}">
    <label
      for="sort-select-{{ section_id }}"
      class="facets__label"
    >
      {{- 'actions.sort' | t -}}
    </label>
    <div class="sorting-filter__select-wrapper">
      <select
        id="sort-select-{{ section_id }}"
        name="sort_by"
        class="sorting-filter__select"
        {% if should_use_select_on_mobile == false %}
          disabled
        {% endif %}
      >
        {% for option in results.sort_options %}
          <option
            value="{{ option.value }}"
            {% if option.value == sort_by %}
              selected
            {% endif %}
          >
            {{ option.name }}
          </option>
        {% endfor %}
      </select>
      <svg
        aria-hidden="true"
        focusable="false"
        class="icon icon-caret"
        width="8"
        height="13"
        viewBox="0 0 8 13"
      >
        {%- render 'icon', icon: 'double-sided-caret' -%}
      </svg>
    </div>
  </div>

  <accordion-custom
    {% if filter_style == 'horizontal' %}
      data-disable-animation-on-desktop="true"
      data-close-with-escape="true"
    {% endif %}
  >
    <details
      ref="details"
      id="Sorting-{{ section_id }}"
      data-default-sort-by="{{ default_sort_by }}"
      class="facets__panel {% if should_use_select_on_mobile %} mobile:hidden {% endif %}"
      data-auto-close-details="desktop,mobile"
      on:toggle="/handleToggle"
    >
      <summary
        class="facets__summary"
        role="button"
        aria-expanded="false"
        aria-controls="sorting-options-{{ section_id }}"
        ref="summary"
      >
        <span
          class="facets__label"
          id="sort-label-{{ section_id }}"
        >
          {{- 'actions.sort' | t -}}
        </span>
        {% if rl_price and rl_chip != '' %}
          <span class="rl-price-chip">{{ rl_chip }}</span>
        {% endif %}
        <span
          class="facets__status h6 desktop:hidden"
        >
          {{- status -}}
        </span>
        <span class="svg-wrapper icon-caret icon-animated">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </summary>
      <floating-panel-component
        id="sorting-options-{{ section_id }}"
        class="sorting-filter__options color-{{ settings.popover_color_scheme }}"
        role="listbox"
        aria-labelledby="sort-label-{{ section_id }}"
        ref="listbox"
      >
        {% if rl_price %}
          {% # Own on:* attributes so the sort component's delegated handlers ignore events from here %}
          <div
            class="rl-price"
            data-rl-price
            data-rl-mode="{% if rl_local %}local{% else %}shopify{% endif %}"
            data-max="{{ rl_max }}"
            data-currency="{{ cart.currency.iso_code }}"
            data-locale="{{ request.locale.iso_code }}"
            on:change="rl-none/none"
            on:input="rl-none/none"
            on:keydown="rl-none/none"
          >
            <div class="rl-menu__title">
              <span>Price range</span>
              {% if rl_chip != '' or rl_local %}
                <button
                  type="button"
                  class="rl-price__reset"
                  data-rl-price-reset
                  {% if rl_chip == '' %}
                    hidden
                  {% endif %}
                >
                  Reset
                </button>
              {% endif %}
            </div>
            <div class="rl-price__fields">
              <label class="rl-price__field">
                <span aria-hidden="true">{{ rl_symbol }}</span>
                <input
                  type="number"
                  inputmode="numeric"
                  min="0"
                  max="{{ rl_max }}"
                  name="{% if rl_local %}rl_min{% else %}{{ price_filter.min_value.param_name }}{% endif %}"
                  value="{{ rl_lo }}"
                  placeholder="0"
                  aria-label="Minimum price"
                  data-rl-price-min
                >
              </label>
              <span class="rl-price__dash" aria-hidden="true"></span>
              <label class="rl-price__field">
                <span aria-hidden="true">{{ rl_symbol }}</span>
                <input
                  type="number"
                  inputmode="numeric"
                  min="0"
                  max="{{ rl_max }}"
                  name="{% if rl_local %}rl_max{% else %}{{ price_filter.max_value.param_name }}{% endif %}"
                  value="{{ rl_hi }}"
                  placeholder="{{ rl_max }}"
                  aria-label="Maximum price"
                  data-rl-price-max
                >
              </label>
            </div>
            <div class="rl-price__slider">
              <input type="range" min="0" max="{{ rl_max }}" step="1" value="{{ rl_lo | default: 0 }}" aria-label="Minimum price" data-rl-range-min>
              <input type="range" min="0" max="{{ rl_max }}" step="1" value="{{ rl_hi | default: rl_max }}" aria-label="Maximum price" data-rl-range-max>
            </div>
            <div class="rl-price__chips">
              {%- liquid
                # Quick-pick ranges scaled to this collection's price range in the
                # shopper's currency: "nice" round numbers near 5%, 20% and 45% of the max.
                assign rl_nice = '1,2,5,10,20,25,50,100,150,200,250,500,1000,1500,2000,2500,5000,10000,15000,20000,25000,50000,100000,150000,200000,250000,500000,1000000,2000000,5000000' | split: ','
                assign rl_targets = '5,20,45' | split: ','
                assign rl_cuts = ''
                assign rl_prev = 0
                for pct in rl_targets
                  assign rl_target = rl_max | times: pct | divided_by: 100
                  assign rl_pick = 0
                  for n in rl_nice
                    assign rl_n = n | plus: 0
                    if rl_n <= rl_target
                      assign rl_pick = rl_n
                    endif
                  endfor
                  if rl_pick > rl_prev
                    assign rl_cuts = rl_cuts | append: rl_pick | append: ','
                    assign rl_prev = rl_pick
                  endif
                endfor
                assign rl_cuts = rl_cuts | split: ','
              -%}
              {%- for cut in rl_cuts -%}
                {%- liquid
                  assign rl_c = cut | plus: 0
                  if forloop.first
                    assign rl_c_lo = ''
                  else
                    assign rl_prev_i = forloop.index0 | minus: 1
                    assign rl_c_lo = rl_cuts[rl_prev_i] | plus: 0
                  endif
                  assign rl_c_label_hi = rl_c | times: 100 | money_without_trailing_zeros
                -%}
                <button
                  type="button"
                  class="rl-price__chip{% if rl_lo == rl_c_lo and rl_hi == rl_c %} is-active{% endif %}"
                  data-rl-price-chip
                  data-min="{{ rl_c_lo }}"
                  data-max="{{ rl_c }}"
                >
                  {%- if rl_c_lo == '' -%}
                    Under {{ rl_c_label_hi }}
                  {%- else -%}
                    {{ rl_c_lo | times: 100 | money_without_trailing_zeros }}–{{ rl_c_label_hi }}
                  {%- endif -%}
                </button>
                {%- if forloop.last -%}
                  <button
                    type="button"
                    class="rl-price__chip{% if rl_lo == rl_c and rl_hi == '' %} is-active{% endif %}"
                    data-rl-price-chip
                    data-min="{{ rl_c }}"
                    data-max=""
                  >
                    {{- rl_c_label_hi }}+
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button type="button" class="rl-price__apply" data-rl-price-apply>Show results</button>
          </div>
        {% endif %}
        {% if deck %}
          <div class="rl-menu__title rl-menu__title--sort"><span>Sort by</span></div>
        {% endif %}
        <div class="sorting-filter__options-inner">
          {% for option in results.sort_options %}
            {% if deck and option.value contains 'title-' %}
              {% continue %}
            {% endif %}
            <label
              for="sort-option-{{ option.value }}-{{ section_id }}"
            >
              <div
                class="sorting-filter__option"
                role="option"
                aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}"
                tabindex="{% if option.value == sort_by %}0{% else %}-1{% endif %}"
              >
                <input
                  type="radio"
                  name="sort_by"
                  id="sort-option-{{ option.value }}-{{ section_id }}"
                  {% if suffix != blank %}
                    form="FacetFiltersForm--{{ section_id }}-{{ suffix }}"
                  {% endif %}
                  value="{{ option.value }}"
                  class="sorting-filter__input"
                  data-option-name="{{ option.name }}"
                  {% if option.value == sort_by %}
                    checked
                  {% endif %}
                  aria-hidden="true"
                >
                <span class="svg-wrapper icon-checkmark sorting-filter__checkmark">
                  {{- 'icon-checkmark.svg' | inline_asset_content -}}
                </span>
                <span class="sorting-filter__label">{{ option.name }}</span>
              </div>
            </label>
          {% endfor %}
        </div>
      </floating-panel-component>
    </details>
  </accordion-custom>
</sorting-filter-component>

{% if rl_price %}
  <script>
    (function () {
      if (window.__rlPriceRange) return;
      window.__rlPriceRange = true;

      function parts(root) {
        return {
          min: root.querySelector('[data-rl-price-min]'),
          max: root.querySelector('[data-rl-price-max]'),
          rMin: root.querySelector('[data-rl-range-min]'),
          rMax: root.querySelector('[data-rl-range-max]'),
          top: parseInt(root.dataset.max, 10) || 0,
        };
      }

      function paintSlider(root) {
        var p = parts(root);
        var lo = parseInt(p.rMin.value, 10) || 0;
        var hi = parseInt(p.rMax.value, 10) || 0;
        var slider = p.rMin.parentElement;
        slider.style.setProperty('--lo', (p.top ? (lo / p.top) * 100 : 0) + '%');
        slider.style.setProperty('--hi', (p.top ? (hi / p.top) * 100 : 100) + '%');
      }

      function clearChips(root) {
        root.querySelectorAll('[data-rl-price-chip]').forEach(function (c) {
          c.classList.remove('is-active');
        });
      }

      function fromSlider(root, moved) {
        var p = parts(root);
        var lo = parseInt(p.rMin.value, 10) || 0;
        var hi = parseInt(p.rMax.value, 10) || 0;
        if (lo > hi) {
          if (moved === p.rMin) p.rMin.value = lo = hi;
          else p.rMax.value = hi = lo;
        }
        p.min.value = lo > 0 ? lo : '';
        p.max.value = hi < p.top ? hi : '';
        paintSlider(root);
        clearChips(root);
      }

      function fromFields(root) {
        var p = parts(root);
        var lo = parseInt(p.min.value, 10);
        var hi = parseInt(p.max.value, 10);
        p.rMin.value = isNaN(lo) ? 0 : Math.max(0, Math.min(lo, p.top));
        p.rMax.value = isNaN(hi) ? p.top : Math.max(0, Math.min(hi, p.top));
        paintSlider(root);
        clearChips(root);
      }

      /* ---- Local mode: filter the loaded grid by each item's local price ---- */
      function fmt(root, n) {
        try {
          return new Intl.NumberFormat(root.dataset.locale || undefined, {
            style: 'currency',
            currency: root.dataset.currency || 'USD',
            maximumFractionDigits: 0,
          }).format(n);
        } catch (err) {
          return String(n);
        }
      }

      function localRange() {
        var params = new URL(window.location.href).searchParams;
        var lo = parseInt(params.get('rl_min'), 10);
        var hi = parseInt(params.get('rl_max'), 10);
        return { lo: isNaN(lo) ? '' : lo, hi: isNaN(hi) ? '' : hi };
      }

      function filterGrid(range) {
        var active = range.lo !== '' || range.hi !== '';
        document.querySelectorAll('.product-grid [data-rl-cost]').forEach(function (item) {
          var price = (parseInt(item.dataset.rlCost, 10) || 0) / 100;
          var out = active && ((range.lo !== '' && price < range.lo) || (range.hi !== '' && price > range.hi));
          item.classList.toggle('rl-price-hidden', out);
        });

        document.querySelectorAll('.product-grid').forEach(function (grid) {
          var items = grid.querySelectorAll('[data-rl-cost]');
          var shown = grid.querySelectorAll('[data-rl-cost]:not(.rl-price-hidden)');
          var pages = parseInt(grid.dataset.lastPage, 10) || 1;
          var loaded = 0;
          items.forEach(function (item) {
            loaded = Math.max(loaded, parseInt(item.dataset.page, 10) || 1);
          });
          var empty = grid.parentElement.querySelector('.rl-price-empty');
          var show = active && items.length > 0 && shown.length === 0 && loaded >= pages;
          if (show && !empty) {
            empty = document.createElement('p');
            empty.className = 'rl-price-empty';
            empty.textContent = 'No products in this price range.';
            grid.insertAdjacentElement('afterend', empty);
          }
          if (empty) empty.hidden = !show;
        });
      }

      function syncLocal() {
        var roots = document.querySelectorAll('[data-rl-price][data-rl-mode="local"]');
        if (!roots.length) return;
        var range = localRange();
        roots.forEach(function (root) {
          var p = parts(root);
          if (document.activeElement !== p.min) p.min.value = range.lo;
          if (document.activeElement !== p.max) p.max.value = range.hi;
          p.rMin.value = range.lo === '' ? 0 : Math.min(range.lo, p.top);
          p.rMax.value = range.hi === '' ? p.top : Math.min(range.hi, p.top);
          paintSlider(root);

          var text = '';
          if (range.lo !== '' && range.hi !== '') text = fmt(root, range.lo) + '–' + fmt(root, range.hi);
          else if (range.lo !== '') text = fmt(root, range.lo) + '+';
          else if (range.hi !== '') text = 'Under ' + fmt(root, range.hi);

          var reset = root.querySelector('[data-rl-price-reset]');
          if (reset) reset.hidden = !text;

          root.querySelectorAll('[data-rl-price-chip]').forEach(function (c) {
            c.classList.toggle('is-active', String(range.lo) === c.dataset.min && String(range.hi) === c.dataset.max);
          });

          var summary = root.closest('details') && root.closest('details').querySelector('summary');
          if (summary) {
            var chip = summary.querySelector('.rl-price-chip');
            if (text && !chip) {
              chip = document.createElement('span');
              chip.className = 'rl-price-chip';
              var label = summary.querySelector('.facets__label');
              if (label) label.insertAdjacentElement('afterend', chip);
              else summary.prepend(chip);
            }
            if (chip) {
              if (text) chip.textContent = text;
              else chip.remove();
            }
          }
        });
        filterGrid(range);
      }

      function applyLocal(root, lo, hi) {
        var url = new URL(window.location.href);
        if (lo === '') url.searchParams.delete('rl_min');
        else url.searchParams.set('rl_min', lo);
        if (hi === '') url.searchParams.delete('rl_max');
        else url.searchParams.set('rl_max', hi);
        history.replaceState(history.state, '', url.toString());

        var details = root.closest('details');
        if (details) details.removeAttribute('open');
        syncLocal();
      }

      function apply(root) {
        var p = parts(root);
        var lo = parseInt(p.min.value, 10);
        var hi = parseInt(p.max.value, 10);
        if (!isNaN(lo) && !isNaN(hi) && lo > hi) {
          var t = lo;
          lo = hi;
          hi = t;
        }
        p.min.value = !isNaN(lo) && lo > 0 ? lo : '';
        p.max.value = !isNaN(hi) ? hi : '';

        if (root.dataset.rlMode === 'local') {
          applyLocal(root, p.min.value === '' ? '' : +p.min.value, p.max.value === '' ? '' : +p.max.value);
          return;
        }

        var details = root.closest('details');
        if (details) details.removeAttribute('open');

        var facetsForm = root.closest('facets-form-component');
        if (facetsForm && typeof facetsForm.updateFilters === 'function') {
          facetsForm.updateFilters();
        } else {
          var form = root.closest('form');
          if (form) form.submit();
        }
      }

      document.addEventListener('input', function (e) {
        var root = e.target.closest && e.target.closest('[data-rl-price]');
        if (!root) return;
        if (e.target.matches('[data-rl-range-min], [data-rl-range-max]')) fromSlider(root, e.target);
        else if (e.target.matches('[data-rl-price-min], [data-rl-price-max]')) fromFields(root);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        var root = e.target.closest && e.target.closest('[data-rl-price]');
        if (!root || !e.target.matches('input[type="number"]')) return;
        e.preventDefault();
        apply(root);
      });

      document.addEventListener('click', function (e) {
        var root = e.target.closest && e.target.closest('[data-rl-price]');
        if (!root) return;
        var p = parts(root);
        var chip = e.target.closest('[data-rl-price-chip]');
        if (chip) {
          p.min.value = chip.dataset.min;
          p.max.value = chip.dataset.max;
          apply(root);
        } else if (e.target.closest('[data-rl-price-reset]')) {
          p.min.value = '';
          p.max.value = '';
          apply(root);
        } else if (e.target.closest('[data-rl-price-apply]')) {
          apply(root);
        }
      });

      var syncing = false;
      function paintAll() {
        if (syncing) return;
        syncing = true;
        document.querySelectorAll('[data-rl-price][data-rl-mode]').forEach(paintSlider);
        syncLocal();
        syncing = false;
      }
      paintAll();
      new MutationObserver(function (records) {
        // Ignore our own chip / empty-state edits; react to new cards and re-rendered sections
        var relevant = records.some(function (r) {
          return !(r.target.closest && r.target.closest('summary, .rl-price-empty'));
        });
        if (relevant) paintAll();
      }).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
{% endif %}

{% if deck %}
  <script>
    (function () {
      // Mobile sort sheet: shown in the browser's top layer (popover API) so it
      // sits above every other overlay, with animated open/close and swipe-down.
      if (window.__rlSheet) return;
      window.__rlSheet = true;

      var mobile = window.matchMedia('(max-width: 749px)');
      var canPop = typeof HTMLElement.prototype.showPopover === 'function';

      function panelOf(details) {
        return details.querySelector('.sorting-filter__options');
      }

      function backdropOf(details) {
        var backdrop = details.querySelector('.rl-sheet-backdrop');
        if (!backdrop) {
          backdrop = document.createElement('div');
          backdrop.className = 'rl-sheet-backdrop';
          backdrop.setAttribute('aria-hidden', 'true');
          backdrop.addEventListener('click', function () {
            close(details);
          });
          panelOf(details).insertAdjacentElement('beforebegin', backdrop);
        }
        return backdrop;
      }

      function show(el) {
        if (!canPop) return;
        el.setAttribute('popover', 'manual');
        if (!el.matches(':popover-open')) el.showPopover();
      }

      function hide(el) {
        if (!el || !el.hasAttribute('popover')) return;
        if (el.matches(':popover-open')) el.hidePopover();
        el.removeAttribute('popover');
      }

      function open(details) {
        var panel = panelOf(details);
        if (!panel) return;
        var backdrop = backdropOf(details);
        details.classList.remove('rl-sheet--out');
        details.classList.add('rl-sheet');
        show(backdrop);
        show(panel);
        panel.style.translate = '';
        document.body.classList.add('rl-sheet-open');
      }

      function cleanup(details) {
        details.classList.remove('rl-sheet', 'rl-sheet--out');
        hide(details.querySelector('.rl-sheet-backdrop'));
        hide(panelOf(details));
        var panel = panelOf(details);
        if (panel) panel.style.translate = '';
        if (!document.querySelector('.rl-deck details.rl-sheet')) {
          document.body.classList.remove('rl-sheet-open');
        }
      }

      function close(details) {
        if (!details || !details.open) return;
        if (!details.classList.contains('rl-sheet') || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          details.removeAttribute('open');
          cleanup(details);
          return;
        }
        if (details.classList.contains('rl-sheet--out')) return;
        details.classList.add('rl-sheet--out');
        setTimeout(function () {
          details.removeAttribute('open');
          cleanup(details);
        }, 260);
      }

      window.rlSortClose = close;

      document.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('.rl-deck .hc-sort-close-btn');
        if (btn) close(btn.closest('details'));
      });

      document.addEventListener(
        'toggle',
        function (e) {
          var details = e.target;
          if (!(details instanceof HTMLDetailsElement) || !details.closest('.rl-deck')) return;
          if (details.open && mobile.matches) open(details);
          else if (!details.open) cleanup(details);
        },
        true
      );

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        var details = document.querySelector('.rl-deck details.rl-sheet[open]');
        if (details) {
          e.stopPropagation();
          close(details);
        }
      }, true);

      // Swipe down on the sheet (when scrolled to the top) to close it
      var drag = null;
      document.addEventListener('touchstart', function (e) {
        var panel = e.target.closest && e.target.closest('.rl-deck details.rl-sheet .sorting-filter__options');
        if (!panel || panel.scrollTop > 0 || e.target.closest('input, .rl-price__slider')) return;
        drag = { panel: panel, y: e.touches[0].clientY, dy: 0 };
      }, { passive: true });

      document.addEventListener('touchmove', function (e) {
        if (!drag) return;
        drag.dy = Math.max(0, e.touches[0].clientY - drag.y);
        drag.panel.style.translate = '0 ' + drag.dy + 'px';
      }, { passive: true });

      document.addEventListener('touchend', function () {
        if (!drag) return;
        var panel = drag.panel;
        var details = panel.closest('details');
        if (drag.dy > 90) {
          close(details);
        } else if (drag.dy > 0) {
          panel.animate([{ translate: '0 ' + drag.dy + 'px' }, { translate: '0 0' }], {
            duration: 220,
            easing: 'cubic-bezier(0.22, 1.12, 0.36, 1)',
          });
          panel.style.translate = '';
        }
        drag = null;
      });
    })();
  </script>
{% endif %}

{% stylesheet %}
  .sorting-filter__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--drawer-padding) 0;
    padding-block: var(--padding-sm);
    margin-inline-end: var(--margin-md);
    position: relative;
  }

  .sorting-filter__container .facets__label {
    font-size: var(--font-h4--size);
  }

  .sorting-filter__select-wrapper {
    display: flex;
    position: relative;
    border-radius: var(--variant-picker-button-radius);
    align-items: center;
    overflow: clip;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .sorting-filter__select-wrapper:has(:focus-visible) {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .sorting-filter__select-wrapper:has(:focus-visible) .sorting-filter__select {
    outline: none;
  }

  .sorting-filter__container .sorting-filter__select {
    appearance: none;
    border: 0;
    margin: 0;
    cursor: pointer;
    width: 100%;
    padding-inline-end: var(--icon-size-2xs);
    text-align: right;

    /* Needed for Safari */
    text-align-last: right;
  }

  .sorting-filter__select .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .sorting-filter {
    @media screen and (min-width: 750px) {
      z-index: var(--facets-upper-z-index);
    }
  }

  .sorting-filter__options {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    position: absolute;
    top: 100%;
    right: 0;
    color: var(--color-foreground);
    z-index: var(--facets-upper-z-index);
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    background-color: var(--color-background);
    border-radius: var(--style-border-radius-popover);
    width: max-content;
    min-width: var(--facets-panel-min-width);
    min-height: 0;

    transition: grid-template-rows var(--animation-speed-slow) var(--animation-easing),
      opacity var(--animation-speed-slow) var(--animation-easing);
  }

  details[open] .sorting-filter__options {
    opacity: 1;
    grid-template-rows: 1fr;
  }

  .sorting-filter__options-inner {
    display: flex;
    flex-direction: column;
    grid-row: 1 / span 2;
    gap: var(--gap-sm);
    padding: calc(var(--drawer-padding) / 2);
    color: var(--color-foreground);
    overflow: clip;
    scrollbar-width: none;
    -ms-overflow-style: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      gap: 0;
    }
  }

  .sorting-filter__option {
    cursor: pointer;
    display: grid;
    grid-template-columns: var(--icon-size-sm) 1fr;
    gap: var(--margin-2xs);
    align-items: center;
    min-width: 180px;
    max-width: 16em;
    padding: var(--padding-2xs) calc(var(--drawer-padding) / 2) var(--padding-2xs) var(--padding-2xs);

    &:hover {
      border-radius: calc(var(--style-border-radius-popover) / 2);
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
    }

    &:focus {
      border-radius: calc(var(--style-border-radius-popover) / 2);
    }
  }

  .sorting-filter__input {
    display: none;

    &:checked + .sorting-filter__checkmark + .sorting-filter__label {
      font-weight: 500;
    }
  }

  .sorting-filter__checkmark {
    visibility: hidden;
  }

  *:checked ~ .sorting-filter__checkmark {
    visibility: visible;
  }

  .sorting-filter__label {
    cursor: pointer;
    pointer-events: none;
  }

  .facets-toggle--no-filters .sorting-filter__select-wrapper {
    @media screen and (max-width: 749px) {
      padding-inline-start: 0;
    }
  }

  .facets-mobile-wrapper .sorting-filter .facets__panel {
    padding-inline: 0;
    position: relative;
  }

  .facets-mobile-wrapper .sorting-filter .facets__status {
    display: none;
  }

  .facets-mobile-wrapper:has(> :nth-child(2)) .sorting-filter .sorting-filter__options {
    left: 0;
    right: unset;
  }

  .facets-mobile-wrapper .sorting-filter .facets__label {
    margin-inline-end: var(--margin-2xs);
    font-size: var(--font-paragraph--size);
    color: var(--color-foreground-muted);
  }

  .facets-toggle .sorting-filter__container {
    @media screen and (max-width: 749px) {
      padding: 0;
    }
  }

  .facets-toggle .sorting-filter__container .facets__label {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .facets-toggle .sorting-filter::before {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .facets--drawer .sorting-filter {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }
{% endstylesheet %}
